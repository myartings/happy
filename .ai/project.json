{
  "schemaVersion": 1,
  "name": "Happy",
  "profile": "typescript-monorepo",
  "maturity": "production",
  "commands": {
    "setup": [
      "pnpm install --frozen-lockfile"
    ],
    "format": [],
    "lint": [],
    "typecheck": [
      "pnpm --filter happy-app typecheck",
      "pnpm --filter happy-server typecheck"
    ],
    "test": [
      "pnpm --filter happy-app exec vitest run",
      "pnpm --filter happy-server test"
    ],
    "build": [],
    "docs-check": [
      "{python} scripts/validate-happy-workflow.py",
      "{python} scripts/workflow-audit.py --all --strict"
    ],
    "workflow-targeted": [
      "{python} scripts/test-happy-workflow-state-upgrade.py",
      "{python} scripts/test-happy-workflow-runtime.py",
      "{python} scripts/validate-happy-workflow.py",
      "{python} scripts/test-validate-happy-workflow.py",
      "{python} scripts/workflow-audit.py --all --strict"
    ],
    "check": [
      "{python} scripts/test-happy-workflow-state-upgrade.py",
      "{python} scripts/test-happy-workflow-runtime.py",
      "{python} scripts/validate-happy-workflow.py",
      "{python} scripts/test-validate-happy-workflow.py",
      "{python} scripts/workflow-audit.py --all --strict"
    ]
  },
  "checkProfiles": {
    "docs": [
      "docs-check"
    ],
    "workflow": [
      "workflow-targeted"
    ],
    "full": [
      "format",
      "lint",
      "typecheck",
      "test",
      "build",
      "check"
    ]
  },
  "checkSelection": {
    "fallbackProfile": "full",
    "rules": [
      {
        "name": "ordinary-documentation",
        "profile": "docs",
        "include": [
          "README.md",
          "docs/*.md",
          "docs/**/*.md"
        ],
        "exclude": [
          ".codex/**",
          "docs/PRD.md",
          "docs/adr/**",
          "docs/specs/**",
          "docs/tasks/**",
          "docs/workflow.md",
          "docs/workflow/**",
          "docs/workspace/**"
        ]
      },
      {
        "name": "workflow-infrastructure",
        "profile": "workflow",
        "include": [
          ".agents/skills/**",
          ".ai/**",
          ".codex/**",
          ".gitattributes",
          ".github/ISSUE_TEMPLATE/**",
          "AGENTS.md",
          "CONTEXT.md",
          "docs/adr/**",
          "docs/specs/**",
          "docs/tasks/**",
          "docs/workflow.md",
          "docs/workflow/**",
          "docs/workspace/**",
          "scripts/workflow-*.py",
          "scripts/happy-workflow-state-upgrade.py",
          "scripts/test-happy-workflow-state-upgrade.py",
          "scripts/test-happy-workflow-runtime.py",
          "scripts/validate-happy-workflow.py",
          "scripts/test-validate-happy-workflow.py",
          "scripts/test-workflow.py",
          "scripts/test-workflow-ci.py",
          "scripts/test-workflow-core.py"
        ],
        "exclude": [],
        "trigger": [
          ".agents/skills/**",
          ".ai/**",
          ".codex/**",
          "AGENTS.md",
          "docs/adr/**",
          "docs/specs/**",
          "docs/tasks/**",
          "docs/workflow.md",
          "docs/workflow/**",
          "docs/workspace/**",
          "scripts/workflow-*.py",
          "scripts/happy-workflow-state-upgrade.py",
          "scripts/test-happy-workflow-state-upgrade.py",
          "scripts/test-happy-workflow-runtime.py",
          "scripts/validate-happy-workflow.py",
          "scripts/test-validate-happy-workflow.py"
        ]
      }
    ]
  },
  "reviewProfiles": {
    "low-risk": {
      "modelTier": "standard",
      "maxWords": 250
    },
    "feature": {
      "modelTier": "capable",
      "maxWords": 400
    },
    "high-risk": {
      "modelTier": "capable",
      "maxWords": 400
    }
  },
  "tracker": {
    "provider": "github",
    "target": "myartings/happy",
    "categories": {
      "bug": "bug",
      "enhancement": "enhancement"
    },
    "states": {
      "needsTriage": "needs-triage",
      "needsInfo": "needs-info",
      "readyForAgent": "ready-for-agent",
      "readyForHuman": "ready-for-human",
      "wontfix": "wontfix"
    }
  },
  "protectedPaths": [
    ".env",
    ".env.*",
    "**/secrets/**",
    "**/credentials/**",
    ".git/**",
    "packages/happy-app/android/**",
    "packages/happy-app/ios/**"
  ],
  "generatedPaths": [
    "node_modules/**",
    "packages/*/node_modules/**",
    "packages/happy-app/dist/**",
    "packages/happy-app/.expo/**",
    "packages/happy-app/src-tauri/target/**",
    "coverage/**"
  ],
  "riskTriggers": [
    "authentication",
    "authorization",
    "GitHub permissions",
    "data migration",
    "privacy",
    "security",
    "production deployment",
    "destructive operation",
    "session protocol",
    "cross-device synchronization"
  ],
  "features": {
    "unattendedIssueCampaign": false
  }
}
