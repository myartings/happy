}


ios_require_submit_configuration() {
  local name
  for name in APP_STORE_CONNECT_API_KEY_PATH APP_STORE_CONNECT_API_KEY_ID \
    APP_STORE_CONNECT_API_ISSUER_ID APP_STORE_CONNECT_APP_ID APPLE_DEVELOPMENT_TEAM; do
    if [[ -z "${!name:-}" ]]; then
      echo "Missing $name in untracked config.env or the environment." >&2
      return 1
    fi
  done
  if [[ ! -f "$APP_STORE_CONNECT_API_KEY_PATH" ]]; then
    echo "App Store Connect API key file not found at the configured path." >&2
    return 1
  fi
}


ios_submit_testflight() {
  local dry_run=0 build_id=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --build-id)
        shift
        build_id="${1:-}"
        ;;
      *) echo "Unknown ios-submit-testflight option: $1" >&2; return 1 ;;
    esac
    shift
  done
  if [[ -z "$build_id" ]]; then
    echo "ios-submit-testflight requires --build-id ID from ios-release-status." >&2
    return 1
  fi
  if [[ ! "$build_id" =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "Invalid EAS build ID." >&2
    return 1
  fi
  if [[ "$dry_run" -eq 0 ]]; then
    ios_require_submit_configuration
  fi
  ios_release_action "submit-testflight" "$HAPPY_MOBILE_STORE_PROFILE" "$dry_run" \
    submit --profile "$HAPPY_MOBILE_STORE_PROFILE" --platform ios --id "$build_id"
}

ios_publish_update() {
  local dry_run=0 message=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --message|-m)
        shift
        message="${1:-}"
        ;;
      *) echo "Unknown ios-publish-update option: $1" >&2; return 1 ;;
    esac
    shift
  done
  if [[ -z "$message" ]]; then
    echo "ios-publish-update requires --message TEXT." >&2
    return 1
  fi
  ios_release_action "publish-update" "$HAPPY_MOBILE_CHANNEL" "$dry_run" \
    update --channel "$HAPPY_MOBILE_CHANNEL" --environment "$HAPPY_MOBILE_EAS_ENVIRONMENT" \
    --platform ios --message "$message"
}

ios_release_status() {
  ios_require_macos
  ios_validate_local_configuration
  ios_run_eas whoami >/dev/null
  echo "Recent Happy Personal iOS builds"
  ios_run_eas build:list --platform ios --channel "$HAPPY_MOBILE_CHANNEL" --limit 10
  echo
  echo "Recent Happy Personal iOS submissions"
  ios_run_eas submit:list --platform ios --limit 10
}

# Shared mobile release implementation. Compatibility wrappers retain the
# existing public iOS helper and command names.
MOBILE_PNPM_ARGV=()

mobile_parse_pnpm_command() {
  local part
  MOBILE_PNPM_ARGV=()
  read -r -a MOBILE_PNPM_ARGV <<<"$HAPPY_PNPM_CMD"
  if [[ "${#MOBILE_PNPM_ARGV[@]}" -eq 0 ]]; then
    echo "HAPPY_PNPM_CMD must name an executable command." >&2
    return 1
  fi
  for part in "${MOBILE_PNPM_ARGV[@]}"; do
    if [[ ! "$part" =~ ^[A-Za-z0-9_./@:+-]+$ ]]; then
      echo "HAPPY_PNPM_CMD contains an unsupported command token: $part" >&2
      return 1
    fi
  done
}

mobile_require_platform() {
  case "$1" in
    ios|android) ;;
    *) echo "Unsupported mobile platform: $1" >&2; return 1 ;;
  esac
}

mobile_platform_label() {
  case "$1" in
    ios) printf 'iOS' ;;
    android) printf 'Android' ;;
  esac
}

mobile_require_host() {
  mobile_require_platform "$1"
  if [[ "$1" == "ios" && "$OS_NAME" != "Darwin" ]]; then
    echo "Happy iOS release commands require macOS with Xcode." >&2
    return 1
  fi
}

mobile_eas_display_command() {
  local platform="$1" part
  shift
  mobile_require_platform "$platform"
  mobile_parse_pnpm_command
  printf 'cd %q && APP_ENV=%q NODE_ENV=production EXPO_NO_METRO_WORKSPACE_ROOT=1' "$HAPPY_MOBILE_APP_DIR" "$HAPPY_MOBILE_APP_ENV"
  if [[ -n "${EXPO_OWNER:-}" ]]; then
    printf ' EXPO_OWNER=<configured>'
  else
    printf ' EXPO_OWNER=<missing>'
  fi
  if [[ -n "${EXPO_PUBLIC_EAS_PROJECT_ID:-}" ]]; then
    printf ' EXPO_PUBLIC_EAS_PROJECT_ID=<configured>'
  else
    printf ' EXPO_PUBLIC_EAS_PROJECT_ID=<missing>'
  fi
  for part in "${MOBILE_PNPM_ARGV[@]}"; do
    printf ' %q' "$part"
  done
  printf ' %q %q' dlx "eas-cli@$HAPPY_MOBILE_EAS_CLI_VERSION"
  printf ' %q' "$@"
  printf '\n'
}

mobile_run_eas() {
  local platform="$1"
  shift
  mobile_parse_pnpm_command
  log "+ $(mobile_eas_display_command "$platform" "$@")" >/dev/null
  (
    cd "$HAPPY_MOBILE_APP_DIR"
    APP_ENV="$HAPPY_MOBILE_APP_ENV" \
      NODE_ENV=production \
      EXPO_NO_METRO_WORKSPACE_ROOT=1 \
      EXPO_OWNER="${EXPO_OWNER:-}" \
      EXPO_PUBLIC_EAS_PROJECT_ID="${EXPO_PUBLIC_EAS_PROJECT_ID:-}" \
      APP_STORE_CONNECT_API_KEY_PATH="${APP_STORE_CONNECT_API_KEY_PATH:-}" \
      APP_STORE_CONNECT_API_KEY_ID="${APP_STORE_CONNECT_API_KEY_ID:-}" \
      APP_STORE_CONNECT_API_ISSUER_ID="${APP_STORE_CONNECT_API_ISSUER_ID:-}" \
      APP_STORE_CONNECT_APP_ID="${APP_STORE_CONNECT_APP_ID:-}" \
      APPLE_DEVELOPMENT_TEAM="${APPLE_DEVELOPMENT_TEAM:-}" \
      "${MOBILE_PNPM_ARGV[@]}" dlx "eas-cli@$HAPPY_MOBILE_EAS_CLI_VERSION" "$@"
  )
}

mobile_validate_eas_profiles() {
  local platform="$1"
  mobile_require_platform "$platform"
  node - "$HAPPY_MOBILE_APP_DIR/eas.json" "$HAPPY_MOBILE_INTERNAL_PROFILE" "$HAPPY_MOBILE_STORE_PROFILE" "$HAPPY_MOBILE_CHANNEL" "$platform" <<'NODE'
const fs = require('node:fs');
const [path, internalName, storeName, channel, platform] = process.argv.slice(2);
const value = JSON.parse(fs.readFileSync(path, 'utf8'));
const internal = value.build?.[internalName];
const store = value.build?.[storeName];
const failures = [];
if (!internal || internal.distribution !== 'internal' || internal.channel !== channel || internal.env?.APP_ENV !== 'personal') failures.push(`build.${internalName}`);
if (!store || store.distribution !== 'store' || store.channel !== channel || store.env?.APP_ENV !== 'personal') failures.push(`build.${storeName}`);
if (platform === 'android' && internal?.android?.buildType !== 'apk') failures.push(`build.${internalName}.android.buildType`);
if (platform === 'ios') {
  const submit = value.submit?.[storeName];
  const expectedSubmit = {
    ascApiKeyPath: '$APP_STORE_CONNECT_API_KEY_PATH',
    ascApiKeyId: '$APP_STORE_CONNECT_API_KEY_ID',
    ascApiKeyIssuerId: '$APP_STORE_CONNECT_API_ISSUER_ID',
    ascAppId: '6806555472',
    appleTeamId: 'MJS6V7A44A',
  };
  if (!submit?.ios) failures.push(`submit.${storeName}`);
  for (const [key, expected] of Object.entries(expectedSubmit)) {
    if (submit?.ios?.[key] !== expected) failures.push(`submit.${storeName}.ios.${key} must use ${expected}`);
  }
}
if (failures.length) {
  console.error(`Invalid personal EAS profiles: ${failures.join(', ')}`);
  process.exit(1);
}
NODE
}

mobile_validate_expo_identity() {
  local platform="$1" owner project_id config_json
  mobile_require_platform "$platform"
  owner="${EXPO_OWNER:-validation-owner}"
  project_id="${EXPO_PUBLIC_EAS_PROJECT_ID:-00000000-0000-4000-8000-000000000000}"
  config_json="$(
    APP_ENV="$HAPPY_MOBILE_APP_ENV" \
      NODE_ENV=production \
      EXPO_NO_METRO_WORKSPACE_ROOT=1 \
      EXPO_OWNER="$owner" \
      EXPO_PUBLIC_EAS_PROJECT_ID="$project_id" \
      $HAPPY_PNPM_CMD -C "$HAPPY_MOBILE_APP_DIR" exec expo config --type public --json
  )"
  PERSONAL_CONFIG_JSON="$config_json" node - "$project_id" "$platform" <<'NODE'
const [expectedProjectId, platform] = process.argv.slice(2);
const config = JSON.parse(process.env.PERSONAL_CONFIG_JSON);
const checks = [
  ['name', config.name, 'Happy Personal'],
  ['slug', config.slug, 'happy-personal'],
  ['scheme', config.scheme, 'happy-personal'],
  ['runtimeVersion.policy', config.runtimeVersion?.policy, 'appVersion'],
  ['extra.eas.projectId', config.extra?.eas?.projectId, expectedProjectId],
];
if (platform === 'ios') {
  const ats = config.ios?.infoPlist?.NSAppTransportSecurity;
  checks.push(['ios.bundleIdentifier', config.ios?.bundleIdentifier, 'com.myartings.happy']);
  checks.push(['ATS.NSAllowsLocalNetworking', ats?.NSAllowsLocalNetworking, true]);
  checks.push(['ATS.NSAllowsArbitraryLoads', ats?.NSAllowsArbitraryLoads, undefined]);
} else {
  checks.push(['android.package', config.android?.package, 'com.myartings.happy']);
}
const failures = checks.filter(([, actual, expected]) => actual !== expected);
if (failures.length) {
  for (const [name, actual, expected] of failures) console.error(`${name}: expected ${String(expected)}, got ${String(actual)}`);
  process.exit(1);
}
NODE
}

mobile_validate_local_configuration() {
  local platform="$1" failed=0 label
  label="$(mobile_platform_label "$platform")"
  mobile_require_host "$platform" || failed=1
  ensure_repo
  if [[ -d "$HAPPY_MOBILE_APP_DIR" ]]; then
    printf 'ok   %-24s %s\n' "Happy $label app" "$HAPPY_MOBILE_APP_DIR"
  else
    printf 'miss %-24s %s\n' "Happy $label app" "$HAPPY_MOBILE_APP_DIR"
    failed=1
  fi
  check_cmd node || failed=1
  if ! $HAPPY_PNPM_CMD --version >/dev/null 2>&1; then
    printf 'miss %-24s %s\n' "pnpm" "$HAPPY_PNPM_CMD failed"
    failed=1
  else
    printf 'ok   %-24s %s\n' "pnpm" "$($HAPPY_PNPM_CMD --version 2>/dev/null | head -n 1)"
  fi
  if [[ "$platform" == "ios" ]]; then
    check_cmd xcodebuild || failed=1
  elif command -v java >/dev/null 2>&1; then
    printf 'ok   %-24s %s\n' "Java (local builds)" "$(command -v java)"
  else
    printf 'info %-24s %s\n' "Java (local builds)" "optional for cloud EAS builds"
  fi
  if mobile_validate_eas_profiles "$platform"; then
    printf 'ok   %-24s %s\n' "EAS profiles" "$HAPPY_MOBILE_INTERNAL_PROFILE / $HAPPY_MOBILE_STORE_PROFILE"
  else
    failed=1
  fi
  if mobile_validate_expo_identity "$platform"; then
    printf 'ok   %-24s %s\n' "Personal identity" "Happy Personal / com.myartings.happy"
  else
    failed=1
  fi
  if [[ -n "${EXPO_OWNER:-}" ]]; then
    printf 'ok   %-24s %s\n' "EXPO_OWNER" "configured"
  else
    printf 'miss %-24s %s\n' "EXPO_OWNER" "set it in config.env"
    failed=1
  fi
  if [[ -n "${EXPO_PUBLIC_EAS_PROJECT_ID:-}" ]]; then
    printf 'ok   %-24s %s\n' "EAS project ID" "configured"
  else
    printf 'miss %-24s %s\n' "EAS project ID" "set EXPO_PUBLIC_EAS_PROJECT_ID in config.env"
    failed=1
  fi
  if [[ "$platform" == "ios" ]]; then
    if [[ -n "${APP_STORE_CONNECT_APP_ID:-}" && -n "${APPLE_DEVELOPMENT_TEAM:-}" && -f "${APP_STORE_CONNECT_API_KEY_PATH:-}" ]]; then
      printf 'ok   %-24s %s\n' "TestFlight config" "configured"
    else
      printf 'info %-24s %s\n' "TestFlight config" "optional until first TestFlight submission"
    fi
  fi
  return "$failed"
}

mobile_require_release_ready() {
  local platform="$1" label branch
  label="$(mobile_platform_label "$platform")"
  mobile_validate_local_configuration "$platform" || return 1
  ensure_clean_repo || return 1
  branch="$(git -C "$HAPPY_REPO" branch --show-current)" || return 1
  if [[ "$branch" != "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    echo "Happy $label releases must run from $HAPPY_DEVTOOLS_FINAL_BRANCH; current branch is $branch." >&2
    return 1
  fi
  mobile_run_eas "$platform" whoami >/dev/null || return 1
}

mobile_doctor() {
  local platform="$1" failed=0 branch dirty label
  label="$(mobile_platform_label "$platform")"
  echo "Checking Happy Personal $label release prerequisites..."
  mobile_validate_local_configuration "$platform" || failed=1
  branch="$(git -C "$HAPPY_REPO" branch --show-current 2>/dev/null || true)"
  dirty="$(git -C "$HAPPY_REPO" status --porcelain 2>/dev/null || true)"
  if [[ "$branch" == "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    printf 'ok   %-24s %s\n' "Release branch" "$branch"
  else
    printf 'warn %-24s %s\n' "Release branch" "current=$branch; release requires $HAPPY_DEVTOOLS_FINAL_BRANCH"
  fi
  if [[ -z "$dirty" ]]; then
    printf 'ok   %-24s %s\n' "Happy worktree" "clean"
  else
    printf 'warn %-24s %s\n' "Happy worktree" "dirty; release will refuse"
  fi
  if mobile_run_eas "$platform" whoami >/dev/null 2>&1; then
    printf 'ok   %-24s %s\n' "EAS login" "authenticated"
  else
    printf 'miss %-24s %s\n' "EAS login" "run eas login for the personal Expo account"
    failed=1
  fi
  return "$failed"
}

mobile_parse_dry_run() {
