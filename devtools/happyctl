doctor() {
  local failed=0
  echo "Checking local Happy manager prerequisites..."
  check_cmd git || failed=1
  check_cmd npm || failed=1
  check_cmd node || failed=1
  if ! $HAPPY_PNPM_CMD --version >/dev/null 2>&1; then
    printf 'miss %-14s %s\n' "pnpm" "$HAPPY_PNPM_CMD failed"
    failed=1
  else
    printf 'ok   %-14s %s\n' "pnpm" "$($HAPPY_PNPM_CMD --version 2>/dev/null | head -n 1)"
  fi
  check_cmd cargo || failed=1
  check_cmd rustc || failed=1
  if [[ "$OS_NAME" == "Linux" ]]; then
    check_cmd rustup || failed=1
  elif command -v rustup >/dev/null 2>&1; then
    printf 'ok   %-14s %s\n' "rustup" "$(rustup --version | head -n 1)"
  else
    printf 'info %-14s %s\n' "rustup" "not found; using cargo/rustc directly"
  fi

  if [[ "$OS_NAME" == "Darwin" ]]; then
    check_cmd osascript || failed=1
    check_cmd ditto || failed=1
    check_cmd open || failed=1
    check_cmd plutil || failed=1
    check_cmd launchctl || failed=1
    check_cmd xcode-select || failed=1
  elif [[ "$OS_NAME" == "Linux" ]]; then
    check_cmd pkg-config || failed=1
    check_cmd gcc || failed=1
    check_cmd g++ || failed=1
    check_cmd make || failed=1
    check_cmd patchelf || failed=1
    check_cmd desktop-file-validate || failed=1
    check_cmd fusermount || check_cmd fusermount3 || true
    check_cmd dpkg || true
    check_cmd rpmbuild || true

    echo
    echo "Linux Tauri pkg-config dependencies:"
    check_pkg_config webkit2gtk-4.1 || check_pkg_config webkit2gtk-4.0 || failed=1
    check_pkg_config javascriptcoregtk-4.1 || check_pkg_config javascriptcoregtk-4.0 || failed=1
    check_pkg_config gtk+-3.0 || failed=1
    check_pkg_config ayatana-appindicator3-0.1 || check_pkg_config appindicator3-0.1 || failed=1
    check_pkg_config librsvg-2.0 || failed=1
    check_pkg_config openssl || failed=1
    echo
    echo "Suggested Debian/Ubuntu packages if missing:"
    echo "  pkg-config patchelf libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev"
    echo "Rust toolchain is also required: rustup + stable rustc/cargo."
  fi

  echo
  if [[ -d "$HAPPY_REPO/.git" ]]; then
    echo "ok   Happy repo     $HAPPY_REPO"
  else
    echo "miss Happy repo     $HAPPY_REPO"
    failed=1
  fi

  if ! check_git_push_guard; then
    failed=1
  fi

  if [[ "$OS_NAME" == "Linux" ]]; then
    echo "info Linux supports build verification and Debian .deb update. refresh task, rollback, and autostart are not implemented."
  elif [[ -d "$INSTALL_APP" ]]; then
    echo "ok   Installed app  $INSTALL_APP"
  else
    echo "warn Installed app  not found at $INSTALL_APP"
  fi

  echo
  status

  if [[ "$failed" -ne 0 ]]; then
    echo
    echo "Doctor found missing required prerequisites." >&2
    exit 1
  fi
}

