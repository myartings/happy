}

mobile_release_action() {
  local platform="$1" kind="$2" profile="$3" dry_run="$4" label
  shift 4
  label="$(mobile_platform_label "$platform")"
  if [[ "$dry_run" -eq 1 ]]; then
    echo "Happy Personal $label $kind dry run"
