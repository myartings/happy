    echo "Suggested Debian/Ubuntu packages if missing:"
    echo "  pkg-config patchelf libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libssl-dev"
    echo "Rust toolchain is also required: rustup + stable rustc/cargo."
  fi

  echo
  if [[ -d "$HAPPY_REPO/.git" ]]; then
    echo "ok   Happy repo     $HAPPY_REPO"
  else
    echo "miss Happy repo     $HAPPY_REPO"
    failed=1
  fi

  if ! check_git_push_guard; then
    failed=1
  fi

  if [[ "$OS_NAME" == "Linux" ]]; then
    echo "info Linux supports build verification and Debian .deb update. refresh task, rollback, and autostart are not implemented."
  elif [[ -d "$INSTALL_APP" ]]; then
    echo "ok   Installed app  $INSTALL_APP"
  else
    echo "warn Installed app  not found at $INSTALL_APP"
  fi

  echo
  status

  if [[ "$failed" -ne 0 ]]; then
    echo
    echo "Doctor found missing required prerequisites." >&2
    exit 1
  fi
}

update_cli() {
  linux_only_build_notice
  require_cmd npm
  log "Updating Happy CLI from npm global package"
  log "Before: $(happy_cli_version_without_exec)"
  run npm install -g happy@latest
  log "After: $(happy_cli_version_without_exec)"
}

require_github_issues_build_configuration() {
  local name
  for name in EXPO_PUBLIC_HAPPY_GITHUB_ISSUES_CLIENT_ID EXPO_PUBLIC_HAPPY_GITHUB_ISSUES_APP_SLUG; do
    if [[ -z "${!name:-}" ]]; then
      echo "Missing $name in untracked config.env or the environment." >&2
      return 1
    fi
  done
}

pull_repo() {
  ensure_repo
  ensure_clean_repo
  log "Updating Happy repo at $HAPPY_REPO"
  log "Before commit: $(current_happy_commit)"
  run git -C "$HAPPY_REPO" fetch --prune --tags origin
  run git -C "$HAPPY_REPO" pull --ff-only
  log "After commit: $(current_happy_commit)"
}

pull_repo_if_needed() {
  local state="$1"
  local ahead behind
  IFS='|' read -r _ _ _ ahead behind <<<"$state"
  if [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
    echo "Happy repo diverged from upstream; refusing automatic refresh." >&2
    exit 1
  fi
  if [[ "$behind" -eq 0 ]]; then
    return 1
  fi
  run git -C "$HAPPY_REPO" pull --ff-only
  return 0
}

build_desktop() {
  if ! $HAPPY_PNPM_CMD --version >/dev/null 2>&1; then
    echo "Missing or failing pnpm command: $HAPPY_PNPM_CMD" >&2
    exit 1
  fi
  require_cmd cargo
  ensure_repo
  if [[ "$HAPPY_DESKTOP_PROFILE" != "official-baseline" ]]; then
    require_github_issues_build_configuration || return 1
  fi
  log "Installing JS dependencies"
  if [[ "$HAPPY_DESKTOP_PROFILE" == "official-baseline" ]]; then
    install_official_baseline_dependencies || return 1
  else
    install_js_dependencies || return 1
  fi
  log "Building Happy Desktop app bundle"
  if [[ "$OS_NAME" == "Linux" ]]; then
    log "+ CARGO_BUILD_JOBS=1 RUSTFLAGS=-C link-arg=-Wl,--threads=1 $HAPPY_PNPM_CMD -C $HAPPY_REPO --filter happy-app exec tauri build --config $HAPPY_TAURI_CONFIG --bundles $HAPPY_LINUX_BUNDLES"
    # shellcheck disable=SC2086
    CARGO_BUILD_JOBS=1 RUSTFLAGS="-C link-arg=-Wl,--threads=1" \
      $HAPPY_PNPM_CMD -C "$HAPPY_REPO" --filter happy-app exec tauri build --config "$HAPPY_TAURI_CONFIG" --bundles "$HAPPY_LINUX_BUNDLES"
    artifacts
  else
    run_pnpm -C "$HAPPY_REPO" --filter happy-app exec tauri build --config "$HAPPY_TAURI_CONFIG" --bundles app --no-sign || return 1
    if [[ ! -d "$BUILD_APP" ]]; then
      echo "Build completed but app bundle was not found: $BUILD_APP" >&2
      exit 1
    fi
    log "Built app: $BUILD_APP"
  fi
}

assert_official_baseline_source() {
  ensure_repo
  ensure_clean_repo
  git_ref_exists "$HAPPY_DEVTOOLS_BASE_BRANCH" || {
    echo "Happy personal main ref not found: $HAPPY_DEVTOOLS_BASE_BRANCH" >&2
    return 1
  }
  assert_official_product_equivalence "$HAPPY_DEVTOOLS_BASE_UPSTREAM" "$HAPPY_DEVTOOLS_BASE_BRANCH" || return 1
  if git_ref_exists "origin/$HAPPY_DEVTOOLS_BASE_BRANCH"; then
    if ! git -C "$HAPPY_REPO" merge-base --is-ancestor \
      "origin/$HAPPY_DEVTOOLS_BASE_BRANCH" "$HAPPY_DEVTOOLS_BASE_BRANCH"; then
      echo "$HAPPY_DEVTOOLS_BASE_BRANCH is behind or diverged from origin/$HAPPY_DEVTOOLS_BASE_BRANCH; run happyctl refresh-desktop first." >&2
      return 1
    fi
  fi
}

prepare_official_baseline_worktree() {
  assert_official_baseline_source || return 1
  local target="$HAPPY_OFFICIAL_BASELINE_WORKTREE"
  if [[ -e "$target" ]]; then
    if ! git -C "$target" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "Official baseline path exists but is not a Git worktree: $target" >&2
      return 1
    fi
    if [[ -n "$(git -C "$target" status --porcelain)" ]]; then
      echo "Official baseline worktree has local changes: $target" >&2
      return 1
    fi
    run git -C "$target" checkout --detach "$HAPPY_DEVTOOLS_BASE_BRANCH" || return 1
  else
    mkdir -p "$(dirname "$target")" || return 1
    run git -C "$HAPPY_REPO" worktree add --detach "$target" "$HAPPY_DEVTOOLS_BASE_BRANCH" || return 1
  fi
  if [[ "$(git -C "$target" rev-parse HEAD)" != "$(git -C "$HAPPY_REPO" rev-parse "$HAPPY_DEVTOOLS_BASE_BRANCH")" ]]; then
    echo "Official baseline worktree did not resolve to $HAPPY_DEVTOOLS_BASE_BRANCH" >&2
    return 1
  fi
}

activate_official_baseline_build_paths() {
  HAPPY_REPO="$HAPPY_OFFICIAL_BASELINE_WORKTREE"
  set_desktop_profile official-baseline
  refresh_desktop_paths
}

build_official_baseline() {
  linux_only_build_notice
  set_desktop_profile official-baseline
  prepare_official_baseline_worktree || return 1
  activate_official_baseline_build_paths
  build_desktop
}

update_official_baseline() {
  linux_only_build_notice
  local keep_backups="$HAPPY_DEVTOOLS_KEEP_BACKUPS"
  if [[ "${1:-}" == "--keep-backups" ]]; then
    [[ -n "${2:-}" ]] || { echo "--keep-backups requires a value" >&2; return 1; }
    keep_backups="$2"
  elif [[ "${1:-}" == --keep-backups=* ]]; then
    keep_backups="${1#*=}"
  elif [[ -n "${1:-}" ]]; then
    echo "Unknown update-official-baseline option: $1" >&2
    return 1
  fi
  [[ "$keep_backups" =~ ^[0-9]+$ ]] || { echo "Keep backups must be a non-negative integer, got: $keep_backups" >&2; return 1; }
  activate_official_baseline_build_paths
  install_desktop || return 1
  remove_old_desktop_backups "$keep_backups" || return 1
}

verify_official_baseline() {
  linux_only_build_notice
  activate_official_baseline_build_paths
  verify_desktop || return 1
}

rollback_official_baseline() {
  linux_only_build_notice
  activate_official_baseline_build_paths
  rollback_desktop "${1:-}"
}

refresh_official_baseline() {
  linux_only_build_notice
  local dry_run=0 keep_backups="$HAPPY_DEVTOOLS_KEEP_BACKUPS"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --keep-backups)
        [[ -n "${2:-}" ]] || { echo "--keep-backups requires a value" >&2; return 1; }
        keep_backups="$2"
        shift
        ;;
      --keep-backups=*) keep_backups="${1#*=}" ;;
      *) echo "Unknown refresh-official-baseline option: $1" >&2; return 1 ;;
    esac
    shift
  done
  [[ "$keep_backups" =~ ^[0-9]+$ ]] || { echo "Keep backups must be a non-negative integer, got: $keep_backups" >&2; return 1; }

  set_desktop_profile official-baseline
  if [[ "$dry_run" -eq 1 ]]; then
    echo "macOS official baseline refresh dry run"
    echo "Source:         $HAPPY_DEVTOOLS_BASE_BRANCH (must contain $HAPPY_DEVTOOLS_BASE_UPSTREAM)"
    echo "Worktree:       $HAPPY_OFFICIAL_BASELINE_WORKTREE"
    echo "App:            $HAPPY_APP_NAME"
    echo "Bundle id:      $HAPPY_APP_BUNDLE_ID"
    echo "Install target: $INSTALL_APP"
    echo "Would fetch official/personal remotes, validate source equivalence, prepare the detached worktree, build, stably sign, back up, install, verify, and launch."
    echo "Would not switch the caller worktree, replace Happy (dev).app, push branches, or publish a public release."
    show_backup_retention_preview "$keep_backups"
    echo "No changes made."
    return
  fi

  local source_repo="$HAPPY_REPO" started_at main_commit status="failed" rc=0
  started_at="$(date +%s)"
  set +e
  run git -C "$source_repo" fetch --prune upstream
  rc=$?
  if [[ "$rc" -eq 0 ]] && git -C "$source_repo" remote get-url origin >/dev/null 2>&1; then
    run git -C "$source_repo" fetch --prune origin
    rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then
    HAPPY_REPO="$source_repo"
    assert_official_baseline_source
    rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then
    main_commit="$(git -C "$source_repo" rev-parse "$HAPPY_DEVTOOLS_BASE_BRANCH")"
    prepare_official_baseline_worktree
    rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then
    activate_official_baseline_build_paths
    build_desktop
    rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then install_desktop; rc=$?; fi
  if [[ "$rc" -eq 0 ]]; then remove_old_desktop_backups "$keep_backups"; rc=$?; fi
  if [[ "$rc" -eq 0 ]]; then verify_desktop; rc=$?; fi
  if [[ "$rc" -eq 0 ]]; then launch_desktop; rc=$?; fi
  if [[ "$rc" -eq 0 ]]; then status="success"; fi
  set -e

  write_update_report "refresh-official-baseline" \
    "Status" "$status" \
    "Personal main commit" "${main_commit:-n/a}" \
    "Product source equivalence" "$([[ -n "${main_commit:-}" ]] && echo verified || echo 'not verified')" \
    "Baseline worktree" "$HAPPY_OFFICIAL_BASELINE_WORKTREE" \
    "Install app" "$INSTALL_APP" \
    "Keep backups" "$keep_backups" \
    "Duration seconds" "$(( $(date +%s) - started_at ))" >/dev/null
  [[ "$rc" -eq 0 ]] || return "$rc"
}

artifacts() {
  echo "Happy Desktop artifacts"
  echo "Target dir: $TAURI_TARGET_DIR"
  if [[ -x "$LINUX_EXECUTABLE" ]]; then
    echo "exe:       $LINUX_EXECUTABLE"
  else
    echo "exe:       not found at $LINUX_EXECUTABLE"
  fi
  for dir in \
    "$TAURI_TARGET_DIR/bundle/appimage" \
    "$TAURI_TARGET_DIR/bundle/deb" \
    "$TAURI_TARGET_DIR/bundle/rpm" \
    "$TAURI_TARGET_DIR/bundle/macos" \
    "$TAURI_TARGET_DIR/bundle/msi" \
    "$TAURI_TARGET_DIR/bundle/nsis"; do
    if [[ -d "$dir" ]]; then
      echo "bundle:    $dir"
      find "$dir" -maxdepth 1 -type f -print | sort
    fi
  done
}

latest_linux_deb() {
  find "$TAURI_TARGET_DIR/bundle/deb" -maxdepth 1 -type f -name '*.deb' -print 2>/dev/null | sort -r | head -n 1
}

linux_deb_field() {
  local deb_path="$1"
  local field="$2"
  dpkg-deb -f "$deb_path" "$field" 2>/dev/null || true
}

linux_deb_installed_version() {
  local package_name="$1"
  dpkg-query -W -f='${Version}' "$package_name" 2>/dev/null || true
}

linux_verify_deb_install() {
  local package_name="$1"
  local expected_version="$2"
  local installed_executable="$3"
  local desktop_entry="$4"
  local installed_status installed_version

  installed_status="$(dpkg-query -W -f='${Status}' "$package_name" 2>/dev/null || true)"
  if [[ "$installed_status" != "install ok installed" ]]; then
    echo "Package is not installed cleanly: ${installed_status:-not found}" >&2
    exit 1
  fi

  installed_version="$(linux_deb_installed_version "$package_name")"
  if [[ -n "$expected_version" && "$installed_version" != "$expected_version" ]]; then
    echo "Unexpected installed version: ${installed_version:-not found}; expected $expected_version" >&2
    exit 1
  fi

  if [[ ! -x "$installed_executable" ]]; then
    echo "Installed executable not found or not executable: $installed_executable" >&2
    exit 1
  fi

  if [[ ! -f "$desktop_entry" ]]; then
    echo "Desktop entry not found: $desktop_entry" >&2
    exit 1
  fi

  desktop-file-validate "$desktop_entry"
  echo "ok   package:       $package_name $installed_version"
  echo "ok   executable:    $installed_executable"
  echo "ok   desktop entry: $desktop_entry"
}

linux_launch_smoke() {
  local executable="$1"
  local timeout_seconds="$HAPPY_LINUX_LAUNCH_TIMEOUT"
  if [[ ! "$timeout_seconds" =~ ^[0-9]+$ || "$timeout_seconds" -eq 0 ]]; then
    echo "HAPPY_LINUX_LAUNCH_TIMEOUT must be a positive integer, got: $timeout_seconds" >&2
    exit 1
  fi
  if [[ ! -x "$executable" ]]; then
    echo "Launch smoke executable not found or not executable: $executable" >&2
    exit 1
  fi
  require_cmd timeout

  local output_file rc
  output_file="$(mktemp "${TMPDIR:-/tmp}/happy-linux-launch.XXXXXX.log")"
  set +e
  timeout "${timeout_seconds}s" "$executable" >"$output_file" 2>&1
  rc=$?
  set -e

  if [[ "$rc" -eq 124 ]]; then
    echo "ok   launch smoke:  $executable stayed running for ${timeout_seconds}s"
    rm -f "$output_file"
    return
  fi
  if [[ "$rc" -eq 0 ]]; then
    echo "ok   launch smoke:  $executable exited successfully before ${timeout_seconds}s"
    rm -f "$output_file"
    return
  fi

  echo "Launch smoke failed with exit code $rc. Last output:" >&2
  tail -n 40 "$output_file" >&2 || true
  rm -f "$output_file"
  exit "$rc"
}

linux_update_desktop() {
  local dry_run=0 launch_smoke=0
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --launch-smoke) launch_smoke=1 ;;
      *)
        echo "Unknown update-desktop option on Linux: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  require_cmd dpkg-deb
  require_cmd dpkg-query
  require_cmd apt
  require_cmd desktop-file-validate
  if [[ "$dry_run" -ne 1 ]]; then
    require_cmd sudo
  fi

  local deb_path package_name package_version package_arch package_depends installed_version desktop_entry installed_executable
  deb_path="$(latest_linux_deb)"
  if [[ -z "$deb_path" || ! -f "$deb_path" ]]; then
    echo "Linux .deb artifact not found. Run build-desktop first." >&2
    echo "Expected dir: $TAURI_TARGET_DIR/bundle/deb" >&2
    exit 1
  fi

  package_name="$(linux_deb_field "$deb_path" Package)"
  package_version="$(linux_deb_field "$deb_path" Version)"
  package_arch="$(linux_deb_field "$deb_path" Architecture)"
  package_depends="$(linux_deb_field "$deb_path" Depends)"
  installed_version="$(linux_deb_installed_version "$package_name")"
  installed_executable="$LINUX_INSTALLED_EXECUTABLE"
  desktop_entry="/usr/share/applications/$HAPPY_APP_NAME.desktop"

  if [[ "$dry_run" -eq 1 ]]; then
    echo "Linux .deb desktop update dry run"
  else
    echo "Linux .deb desktop update"
  fi
  echo "Deb artifact:       $deb_path"
  echo "Package:            ${package_name:-unknown}"
  echo "Version:            ${package_version:-unknown}"
  echo "Architecture:       ${package_arch:-unknown}"
  echo "Depends:            ${package_depends:-unknown}"
  if [[ -n "$installed_version" ]]; then
    echo "Installed version:  $installed_version"
  else
    echo "Installed version:  not installed"
  fi
  echo
  if [[ "$dry_run" -eq 1 ]]; then
    echo "Would install with:"
    printf '  sudo apt install %q\n' "$deb_path"
  else
    echo "Installing with apt..."
    run sudo apt install "$deb_path"
  fi
  echo
  if [[ "$dry_run" -eq 1 ]]; then
    echo "Would verify after install:"
    echo "  dpkg-query -W -f='\${Package} \${Version} \${Status}\\n' ${package_name:-happy-dev}"
    echo "  test -x $installed_executable"
    echo "  test -f '$desktop_entry'"
    echo "  desktop-file-validate '$desktop_entry'"
    if [[ "$launch_smoke" -eq 1 ]]; then
      echo "  timeout ${HAPPY_LINUX_LAUNCH_TIMEOUT}s $installed_executable"
    fi
  else
    echo "Verifying installed package..."
    linux_verify_deb_install "${package_name:-happy-dev}" "$package_version" "$installed_executable" "$desktop_entry"
    if [[ "$launch_smoke" -eq 1 ]]; then
      linux_launch_smoke "$installed_executable"
    fi
  fi
  echo
  echo "User data policy:"
  echo "  Do not remove or rewrite app data under the user's home directory."
  echo
  if [[ "$dry_run" -eq 1 ]]; then
    echo "No changes made."
  else
    echo "Linux .deb desktop update completed."
  fi
}

linux_refresh_desktop() {
  local dry_run=0 force=0 launch_smoke=0
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --force|-f) force=1 ;;
      --launch-smoke) launch_smoke=1 ;;
      *)
        echo "Unknown refresh-desktop option on Linux: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  if [[ "$dry_run" -eq 1 ]]; then
    echo "Linux Debian desktop refresh dry run"
    echo "Would fetch official and personal remotes, then update this integration chain:"
    echo "  $HAPPY_DEVTOOLS_BASE_UPSTREAM -> $HAPPY_DEVTOOLS_BASE_BRANCH -> $HAPPY_DEVTOOLS_PATCH_BRANCHES"
    echo "Would always build from: $HAPPY_DEVTOOLS_FINAL_BRANCH"
    if [[ "$force" -eq 1 ]]; then
      echo "Force: would rebuild and reinstall dev even without source changes."
    fi
    echo "Would run doctor, sync main into dev, build .deb/.rpm, run update-desktop dry-run, install .deb, verify, and write a report."
    [[ "$launch_smoke" -eq 1 ]] && echo "Would also run launch smoke verification."
    echo "No branch, push, build, install, package, or report changes made."
    return
  fi

  local started_at status error_message upstream has_update pulled built installed verified pushed launch_smoke_status
  local before_commit before_cli before_desktop after_commit after_cli after_desktop duration deb_path
  local state base_ahead base_behind final_ahead final_behind branch_remote_delta needs_sync final_before_sync
  started_at="$(date +%s)"
  status="failed"
  error_message=""
  upstream="$HAPPY_DEVTOOLS_BASE_UPSTREAM"
  has_update="n/a"
  pulled="false"
  built="false"
  installed="false"
  verified="false"
  pushed="false"
  launch_smoke_status="skipped"
  before_commit="$(current_happy_commit 2>/dev/null || echo "repo not found")"
  before_cli="$(happy_cli_version_without_exec)"
  before_desktop="$(linux_deb_installed_version "$LINUX_PACKAGE_NAME")"
  before_desktop="${before_desktop:-not installed}"

  local rc=0
  set +e
  log "Starting Linux Happy Desktop refresh"
  (doctor)
  rc=$?

  if [[ "$rc" -eq 0 ]]; then
    state="$(happy_patch_stack_state fetch)"
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      show_patch_stack_state "$state"
      IFS='|' read -r base_ahead base_behind final_ahead final_behind branch_remote_delta <<<"$state"
      if ! validate_base_branch_for_refresh; then
        rc=1
      fi
    fi

    if [[ "$rc" -eq 0 ]]; then
      has_update="false"
      needs_sync=0
      if [[ "$base_behind" -gt 0 || "$final_behind" -gt 0 || "$branch_remote_delta" -gt 0 ]]; then
        has_update="true"
        needs_sync=1
      fi
      if [[ "$needs_sync" -eq 0 && "$force" -eq 0 ]]; then
        status="skipped-no-upstream-update"
        log "Happy dev integration is already synchronized; skipping Linux desktop build/update. Use --force to rebuild anyway."
        echo "Official main and personal dev are already synchronized. Skipping Linux desktop refresh."
      else
        final_before_sync="$(git -C "$HAPPY_REPO" rev-parse "$HAPPY_DEVTOOLS_FINAL_BRANCH")"
        sync_patch_stack_locally
        rc=$?
        if [[ "$rc" -eq 0 ]]; then
          pulled="true"
          after_commit="$(git -C "$HAPPY_REPO" rev-parse "$HAPPY_DEVTOOLS_FINAL_BRANCH")"
          if [[ "$after_commit" == "$final_before_sync" && "$force" -eq 0 ]]; then
            push_patch_stack
            rc=$?
            if [[ "$rc" -eq 0 ]]; then
              pushed="true"
              status="synced-no-desktop-change"
              log "Updated/published main and dev; final Linux desktop source did not change, so build/install is not needed."
            fi
          fi
        fi
      fi
    fi
  fi

  if [[ "$rc" -eq 0 && "$force" -ne 0 && "$status" != "synced-no-desktop-change" ]]; then
    has_update="force"
  fi

  if [[ "$rc" -eq 0 && "$status" != "skipped-no-upstream-update" && "$status" != "synced-no-desktop-change" ]]; then
    (build_desktop)
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      built="true"
      push_patch_stack
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      pushed="true"
      (linux_update_desktop --dry-run)
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      (linux_update_desktop)
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      installed="true"
      if [[ "$launch_smoke" -eq 1 ]]; then
        (linux_verify_desktop --launch)
      else
        (linux_verify_desktop)
      fi
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      verified="true"
      if [[ "$launch_smoke" -eq 1 ]]; then
        launch_smoke_status="passed"
      fi
      status="success"
      log "Linux Happy Desktop refresh completed"
    fi
  fi
  set -e

  if [[ "$rc" -ne 0 ]]; then
    status="failed"
    error_message="refresh failed with exit code $rc"
  fi

  after_commit="$(current_happy_commit 2>/dev/null || echo "repo not found")"
  after_cli="$(happy_cli_version_without_exec)"
  after_desktop="$(linux_deb_installed_version "$LINUX_PACKAGE_NAME")"
  after_desktop="${after_desktop:-not installed}"
  deb_path="$(latest_linux_deb)"
  duration="$(( $(date +%s) - started_at ))"
  write_update_report "linux-refresh-desktop" \
    "Status" "$status" \
    "Error" "$error_message" \
    "Force" "$force" \
    "Upstream" "$upstream" \
    "Final branch ahead" "${final_ahead:-n/a}" \
    "Final branch behind" "${final_behind:-n/a}" \
    "Personal branch/remote delta" "${branch_remote_delta:-n/a}" \
    "Update available" "$has_update" \
    "Synced dev integration" "$pulled" \
    "Pushed dev integration" "$pushed" \
    "Built desktop" "$built" \
    "Installed desktop" "$installed" \
    "Verified desktop" "$verified" \
    "Launch smoke" "$launch_smoke_status" \
    "Happy commit before" "$before_commit" \
    "Happy commit after" "$after_commit" \
    "CLI version before" "$before_cli" \
    "CLI version after" "$after_cli" \
    "Desktop version before" "$before_desktop" \
    "Desktop version after" "$after_desktop" \
    "Deb artifact" "$deb_path" \
    "Install package" "$LINUX_PACKAGE_NAME" \
    "Installed executable" "$LINUX_INSTALLED_EXECUTABLE" \
    "Duration seconds" "$duration" >/dev/null

  if [[ "$rc" -ne 0 ]]; then
    exit "$rc"
  fi
}

linux_verify_desktop() {
  local launch=0
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --launch) launch=1 ;;
      *)
        echo "Unknown verify-desktop option on Linux: $1" >&2
        exit 1
        ;;
    esac
    shift
  done

  require_cmd dpkg-query
  require_cmd desktop-file-validate

  local deb_path package_name expected_version desktop_entry
  deb_path="$(latest_linux_deb)"
  if [[ -n "$deb_path" && -f "$deb_path" ]]; then
    require_cmd dpkg-deb
    package_name="$(linux_deb_field "$deb_path" Package)"
    expected_version="$(linux_deb_field "$deb_path" Version)"
  fi
  package_name="${package_name:-$LINUX_PACKAGE_NAME}"
  desktop_entry="/usr/share/applications/$HAPPY_APP_NAME.desktop"

  linux_verify_deb_install "$package_name" "$expected_version" "$LINUX_INSTALLED_EXECUTABLE" "$desktop_entry"
  if [[ "$launch" -eq 1 ]]; then
    linux_launch_smoke "$LINUX_INSTALLED_EXECUTABLE"
  fi
}

quit_desktop() {
  log "Quitting Happy Desktop if running"
  osascript -e "tell application id \"$HAPPY_APP_BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
  sleep 2
}

backup_installed_app() {
  if [[ ! -d "$INSTALL_APP" ]]; then
    log "No installed app to back up"
    return
  fi

  mkdir -p "$HAPPY_DEVTOOLS_BACKUP_DIR"
  local stamp backup_path
  stamp="$(date '+%Y%m%d-%H%M%S')"
  backup_path="$HAPPY_DEVTOOLS_BACKUP_DIR/${HAPPY_APP_NAME%.app}-$stamp.app"
  log "Backing up installed app to $backup_path"
  run ditto "$INSTALL_APP" "$backup_path"
}

desktop_backup_paths() {
  find "$HAPPY_DEVTOOLS_BACKUP_DIR" -maxdepth 1 -type d -name "${HAPPY_APP_NAME%.app}-*.app" -print 2>/dev/null | sort -r
}

macos_valid_signing_identities() {
  security find-identity -v -p codesigning
}

resolve_macos_signing_identity() {
  local identities eligible configured identity
  identities="$(macos_valid_signing_identities)" || {
    echo "Unable to inspect valid macOS code-signing identities." >&2
    return 1
  }

  eligible="$({
    printf '%s\n' "$identities" | sed -n 's/^[[:space:]]*[0-9][0-9]*) [0-9A-Fa-f]* "\(Apple Development:.*\)"$/\1/p'
    printf '%s\n' "$identities" | sed -n 's/^[[:space:]]*[0-9][0-9]*) [0-9A-Fa-f]* "\(Developer ID Application:.*\)"$/\1/p'
  })"

  configured="${HAPPY_MACOS_SIGNING_IDENTITY:-}"
  if [[ -n "$configured" ]]; then
    if ! printf '%s\n' "$eligible" | grep -Fx -- "$configured" >/dev/null; then
      echo "Configured macOS signing identity is not an eligible valid identity: $configured" >&2
      return 1
    fi
    printf '%s\n' "$configured"
    return
  fi

  identity="$(printf '%s\n' "$identities" | sed -n 's/^[[:space:]]*[0-9][0-9]*) [0-9A-Fa-f]* "\(Apple Development:.*\)"$/\1/p' | head -n 1)"
  if [[ -z "$identity" ]]; then
    identity="$(printf '%s\n' "$identities" | sed -n 's/^[[:space:]]*[0-9][0-9]*) [0-9A-Fa-f]* "\(Developer ID Application:.*\)"$/\1/p' | head -n 1)"
  fi
  if [[ -z "$identity" ]]; then
    echo "No valid Developer ID Application or Apple Development signing identity found; refusing ad-hoc signing." >&2
    return 1
  fi
  printf '%s\n' "$identity"
}

verify_stable_desktop_signature() {
  local app_path="$1" details team_id
  codesign --verify --deep --strict "$app_path" || {
    echo "Strict code-signature verification failed: $app_path" >&2
    return 1
  }
  details="$(codesign -dv --verbose=4 "$app_path" 2>&1)" || {
    echo "Unable to inspect code signature: $app_path" >&2
    return 1
  }
  if printf '%s\n' "$details" | grep -F 'Signature=adhoc' >/dev/null; then
    echo "Ad-hoc code signature is not allowed for Happy Desktop refresh." >&2
    return 1
  fi
  team_id="$(printf '%s\n' "$details" | awk -F= '/^TeamIdentifier=/ && !found { value=$2; found=1 } END { print value }')"
  if [[ -z "$team_id" || "$team_id" == "not set" ]]; then
    echo "Stable Happy Desktop signature has no Team Identifier." >&2
    return 1
  fi
}

sign_desktop_app() {
  local app_path="$1" identity entitlements
  check_cmd codesign || return 1
  check_cmd security || return 1
  identity="$(resolve_macos_signing_identity)" || return 1
  entitlements="$HAPPY_REPO/packages/happy-app/src-tauri/entitlements.plist"
  if [[ ! -f "$entitlements" ]]; then
    echo "macOS entitlements file not found: $entitlements" >&2
    return 1
  fi
  log "Signing app with stable identity: $identity"
  run codesign --force --options runtime --timestamp=none \
    --entitlements "$entitlements" \
    --sign "$identity" \
    --identifier "$HAPPY_APP_BUNDLE_ID" \
    "$app_path" || return 1
  verify_stable_desktop_signature "$app_path" || return 1
}

remove_old_desktop_backups() {
  local keep="$1"
  if [[ ! "$keep" =~ ^[0-9]+$ ]]; then
    echo "Keep backups must be a non-negative integer, got: $keep" >&2
    exit 1
  fi
  if [[ ! -d "$HAPPY_DEVTOOLS_BACKUP_DIR" ]]; then
    return
  fi

  local index=0 backup_path backup_root
  backup_root="$(cd "$HAPPY_DEVTOOLS_BACKUP_DIR" && pwd)"
  while IFS= read -r backup_path; do
    if [[ "$index" -lt "$keep" ]]; then
      index=$((index + 1))
      continue
    fi

    local full_path
    full_path="$(cd "$(dirname "$backup_path")" && pwd)/$(basename "$backup_path")"
    if [[ "$full_path" != "$backup_root"/* ]]; then
      echo "Refusing to remove backup outside backup root: $full_path" >&2
      exit 1
    fi

    log "Removing old desktop backup: $full_path"
    rm -rf "$full_path"
    index=$((index + 1))
  done < <(desktop_backup_paths)
}

show_backup_retention_preview() {
  local keep="$1"
  echo "Backup dir:    $HAPPY_DEVTOOLS_BACKUP_DIR"
  echo "Keep backups:  $keep"
  if [[ ! -d "$HAPPY_DEVTOOLS_BACKUP_DIR" ]]; then
    echo "Existing backups: 0"
    echo "Backups to remove after success: none"
    return
  fi

  local index=0 remove_count=0 backup_path
  while IFS= read -r backup_path; do
    if [[ "$index" -ge "$keep" ]]; then
      if [[ "$remove_count" -eq 0 ]]; then
        echo "Backups that would be removed after success:"
      fi
      echo "  $backup_path"
      remove_count=$((remove_count + 1))
    fi
    index=$((index + 1))
  done < <(desktop_backup_paths)

  echo "Existing backups: $index"
  if [[ "$remove_count" -eq 0 ]]; then
    echo "Backups to remove after success: none"
  fi
}

install_desktop() {
  linux_only_build_notice
  if [[ ! -d "$BUILD_APP" ]]; then
    echo "Built app not found. Run build-desktop first: $BUILD_APP" >&2
    exit 1
  fi

  if [[ "$OS_NAME" == "Darwin" ]]; then
    sign_desktop_app "$BUILD_APP" || return 1
  fi
  quit_desktop || return 1
  backup_installed_app || return 1
  log "Installing app to $INSTALL_APP"
  rm -rf "$INSTALL_APP" || return 1
  run ditto "$BUILD_APP" "$INSTALL_APP" || return 1
}

launch_desktop() {
  linux_only_build_notice
  if [[ ! -d "$INSTALL_APP" ]]; then
    echo "Installed app not found: $INSTALL_APP" >&2
    exit 1
  fi
  log "Launching $INSTALL_APP"
  run open "$INSTALL_APP"
}

verify_desktop() {
  if [[ "$OS_NAME" == "Linux" ]]; then
    linux_verify_desktop "$@"
    return
  fi
  if [[ "$#" -gt 0 ]]; then
    echo "Unknown verify-desktop option on $OS_NAME: $1" >&2
    exit 1
  fi
  linux_only_build_notice
  if [[ ! -d "$INSTALL_APP" ]]; then
    echo "Installed app not found: $INSTALL_APP" >&2
    exit 1
  fi

  local info_plist bundle_id
  info_plist="$INSTALL_APP/Contents/Info.plist"
  if [[ ! -f "$info_plist" ]]; then
    echo "Installed app Info.plist not found: $info_plist" >&2
    exit 1
  fi

  bundle_id="$(defaults read "$info_plist" CFBundleIdentifier 2>/dev/null || true)"
  if [[ "$bundle_id" != "$HAPPY_APP_BUNDLE_ID" ]]; then
    echo "Unexpected bundle id: ${bundle_id:-not found}; expected $HAPPY_APP_BUNDLE_ID" >&2
    exit 1
  fi

  if [[ "$OS_NAME" == "Darwin" ]]; then
    local signing_id
    signing_id="$(codesign -dv "$INSTALL_APP" 2>&1 | awk -F= '/^Identifier=/ && !found { value=$2; found=1 } END { print value }')"
    if [[ "$signing_id" != "$HAPPY_APP_BUNDLE_ID" ]]; then
      echo "Unexpected codesign identifier: ${signing_id:-not found}; expected $HAPPY_APP_BUNDLE_ID" >&2
      exit 1
    fi
    echo "ok   codesign id:   $signing_id"
    verify_stable_desktop_signature "$INSTALL_APP" || return 1
    echo "ok   stable signing: verified"
  fi

  echo "ok   installed app: $INSTALL_APP"
  echo "ok   bundle id:     $bundle_id"
}

latest_backup_app() {
  desktop_backup_paths | head -n 1
}

rollback_desktop() {
  linux_only_build_notice
  local backup_app="${1:-}"
  if [[ -z "$backup_app" ]]; then
    backup_app="$(latest_backup_app)"
  fi

  if [[ -z "$backup_app" || ! -d "$backup_app" ]]; then
    echo "No desktop backup found in $HAPPY_DEVTOOLS_BACKUP_DIR" >&2
    exit 1
  fi

  quit_desktop
  log "Rolling back desktop app from $backup_app"
  rm -rf "$INSTALL_APP"
  run ditto "$backup_app" "$INSTALL_APP"
  launch_desktop
}

update_desktop() {
  if [[ "$OS_NAME" == "Linux" ]]; then
    linux_update_desktop "$@"
    return
  fi
  if [[ "$#" -gt 0 ]]; then
    echo "Unknown update-desktop option on $OS_NAME: $1" >&2
    exit 1
  fi
  linux_only_build_notice
  pull_repo
  build_desktop
  install_desktop
  remove_old_desktop_backups "$HAPPY_DEVTOOLS_KEEP_BACKUPS"
  launch_desktop
}

update_all() {
  linux_only_build_notice
  update_cli
  update_desktop
}

refresh_desktop() {
  if [[ "$OS_NAME" == "Linux" ]]; then
    linux_refresh_desktop "$@"
    return
  fi
  linux_only_build_notice
  local dry_run=0 force=0 keep_backups="$HAPPY_DEVTOOLS_KEEP_BACKUPS"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --force|-f) force=1 ;;
      --keep-backups)
        if [[ -z "${2:-}" ]]; then
          echo "--keep-backups requires a value" >&2
          exit 1
        fi
        keep_backups="$2"
        shift
        ;;
      --keep-backups=*)
        keep_backups="${1#*=}"
        ;;
      *)
        echo "Unknown refresh-desktop option: $1" >&2
        exit 1
        ;;
    esac
    shift
  done
  if [[ ! "$keep_backups" =~ ^[0-9]+$ ]]; then
    echo "Keep backups must be a non-negative integer, got: $keep_backups" >&2
    exit 1
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    echo "macOS desktop refresh dry run"
    echo "Would fetch official and personal remotes, then update this integration chain:"
    echo "  $HAPPY_DEVTOOLS_BASE_UPSTREAM -> $HAPPY_DEVTOOLS_BASE_BRANCH -> $HAPPY_DEVTOOLS_PATCH_BRANCHES"
    echo "Would always build from: $HAPPY_DEVTOOLS_FINAL_BRANCH"
    echo "After a conflict-free merge it would build .app, push synchronized main and dev, install, verify, launch, and write a report."
    echo "A dirty worktree, diverged main/remote branch, merge conflict, build failure, or push failure stops before replacing the installed app."
    if [[ "$force" -eq 1 ]]; then
      echo "Force: would rebuild and reinstall dev even without source changes."
    fi
    show_backup_retention_preview "$keep_backups"
    echo "No changes made."
    return
  fi

  local started_at status error_message state upstream ahead behind has_update pulled built installed verified pushed
  local before_commit before_cli before_desktop after_commit after_cli duration
  local base_ahead base_behind final_ahead final_behind branch_remote_delta needs_sync final_before_sync
  started_at="$(date +%s)"
  status="failed"
  error_message=""
  upstream="n/a"
  ahead="n/a"
  behind="n/a"
  has_update="n/a"
  pulled="false"
  built="false"
  installed="false"
  verified="false"
  pushed="false"
  before_commit="$(current_happy_commit 2>/dev/null || echo "repo not found")"
  before_cli="$(happy_cli_version_without_exec)"
  before_desktop="$(defaults read "$INSTALL_APP/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "not installed")"

  local rc=0
  set +e
  log "Starting macOS Happy Desktop refresh"
  (doctor)
  rc=$?

  if [[ "$rc" -eq 0 ]]; then
    state="$(happy_patch_stack_state fetch)"
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      show_patch_stack_state "$state"
      IFS='|' read -r base_ahead base_behind final_ahead final_behind branch_remote_delta <<<"$state"
      upstream="$HAPPY_DEVTOOLS_BASE_UPSTREAM"
      ahead="$final_ahead"
      behind="$final_behind"
      if ! validate_base_branch_for_refresh; then
        rc=1
      fi
    fi

    if [[ "$rc" -eq 0 ]]; then
      has_update="false"
      needs_sync=0
      if [[ "$base_behind" -gt 0 || "$final_behind" -gt 0 || "$branch_remote_delta" -gt 0 ]]; then
        has_update="true"
        needs_sync=1
      fi
      if [[ "$needs_sync" -eq 0 && "$force" -eq 0 ]]; then
        status="skipped-no-upstream-update"
        log "Happy dev integration is already synchronized; skipping desktop build/update. Use --force to rebuild anyway."
        echo "Official main and personal dev are already synchronized. Skipping desktop refresh."
      else
        final_before_sync="$(git -C "$HAPPY_REPO" rev-parse "$HAPPY_DEVTOOLS_FINAL_BRANCH")"
        sync_patch_stack_locally
        rc=$?
        if [[ "$rc" -eq 0 ]]; then
          pulled="true"
          after_commit="$(git -C "$HAPPY_REPO" rev-parse "$HAPPY_DEVTOOLS_FINAL_BRANCH")"
          if [[ "$after_commit" == "$final_before_sync" && "$force" -eq 0 ]]; then
            push_patch_stack
            rc=$?
            if [[ "$rc" -eq 0 ]]; then
              pushed="true"
              status="synced-no-desktop-change"
              log "Updated/published main and dev; final desktop source did not change, so build/install is not needed."
            fi
          fi
        fi
      fi
    fi
  fi

  if [[ "$rc" -eq 0 && "$status" != "skipped-no-upstream-update" && "$status" != "synced-no-desktop-change" ]]; then
    (build_desktop)
    rc=$?
    if [[ "$rc" -eq 0 ]]; then
      built="true"
      push_patch_stack
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      pushed="true"
      (install_desktop)
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      installed="true"
      remove_old_desktop_backups "$keep_backups"
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      (verify_desktop)
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      verified="true"
      (launch_desktop)
      rc=$?
    fi
    if [[ "$rc" -eq 0 ]]; then
      status="success"
      log "macOS Happy Desktop refresh completed"
    fi
  fi
  set -e

  if [[ "$rc" -ne 0 ]]; then
    status="failed"
    error_message="refresh failed with exit code $rc"
  fi

  after_commit="$(current_happy_commit 2>/dev/null || echo "repo not found")"
  after_cli="$(happy_cli_version_without_exec)"
  duration="$(( $(date +%s) - started_at ))"
  write_update_report "refresh-desktop" \
    "Status" "$status" \
    "Error" "$error_message" \
    "Force" "$force" \
    "Upstream" "$upstream" \
    "Ahead" "$ahead" \
    "Behind" "$behind" \
    "Update available" "$has_update" \
    "Pulled upstream" "$pulled" \
    "Pushed main and dev" "$pushed" \
    "Built desktop" "$built" \
    "Installed desktop" "$installed" \
    "Verified desktop" "$verified" \
    "Happy commit before" "$before_commit" \
    "Happy commit after" "$after_commit" \
    "CLI version before" "$before_cli" \
    "CLI version after" "$after_cli" \
    "Desktop version before" "$before_desktop" \
    "Install app" "$INSTALL_APP" \
    "Keep backups" "$keep_backups" \
    "Duration seconds" "$duration" >/dev/null

  if [[ "$rc" -ne 0 ]]; then
    exit "$rc"
  fi
}

install_refresh_task() {
  linux_only_build_notice
  local task_time="${1:-$HAPPY_DEVTOOLS_REFRESH_TIME}"
  if [[ ! "$task_time" =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
    echo "Task time must be HH:MM, got: $task_time" >&2
    exit 1
  fi

  local hour minute
  hour="${task_time%%:*}"
  minute="${task_time##*:}"
  if (( 10#$hour > 23 || 10#$minute > 59 )); then
    echo "Task time must be valid HH:MM, got: $task_time" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$LAUNCH_AGENT_PLIST")"
  mkdir -p "$HAPPY_DEVTOOLS_LOG_DIR"
  cat >"$LAUNCH_AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$HAPPY_DEVTOOLS_REFRESH_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$SCRIPT_DIR/happyctl</string>
    <string>refresh-desktop</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$HAPPY_REPO</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$((10#$hour))</integer>
    <key>Minute</key>
    <integer>$((10#$minute))</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$HAPPY_DEVTOOLS_LOG_DIR/happyctl-refresh.out.log</string>
  <key>StandardErrorPath</key>
  <string>$HAPPY_DEVTOOLS_LOG_DIR/happyctl-refresh.err.log</string>
</dict>
</plist>
EOF

  plutil -lint "$LAUNCH_AGENT_PLIST" >/dev/null
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT_PLIST" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT_PLIST"
  launchctl enable "gui/$(id -u)/$HAPPY_DEVTOOLS_REFRESH_LABEL" >/dev/null 2>&1 || true
  echo "Installed refresh task: $HAPPY_DEVTOOLS_REFRESH_LABEL at $task_time"
  echo "Plist: $LAUNCH_AGENT_PLIST"
}

refresh_task_status() {
  linux_only_build_notice
  echo "Refresh task label: $HAPPY_DEVTOOLS_REFRESH_LABEL"
  echo "Plist: $LAUNCH_AGENT_PLIST"
  if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then
    echo "Plist exists."
    plutil -lint "$LAUNCH_AGENT_PLIST"
  else
    echo "Plist not installed."
  fi
  launchctl print "gui/$(id -u)/$HAPPY_DEVTOOLS_REFRESH_LABEL" 2>/dev/null || echo "LaunchAgent is not loaded."
}

uninstall_refresh_task() {
  linux_only_build_notice
  launchctl bootout "gui/$(id -u)" "$LAUNCH_AGENT_PLIST" >/dev/null 2>&1 || true
  if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then
    rm -f "$LAUNCH_AGENT_PLIST"
  fi
  echo "Removed refresh task: $HAPPY_DEVTOOLS_REFRESH_LABEL"
}

cmd="${1:-}"
case "$cmd" in
  doctor) doctor ;;
  status) status ;;
  check-upstream) check_upstream ;;
  install-git-guards) install_git_push_guard ;;
  validate-main-push) shift; validate_main_push_candidate "${1:-}" "${2:-}" ;;
  sync-dev|sync-patch-stack) shift; sync_patch_stack_command "${1:-}" ;;
  update-cli) update_cli ;;
  build-desktop) build_desktop ;;
  artifacts) artifacts ;;
  update-desktop) shift; update_desktop "$@" ;;
  refresh-desktop) shift; refresh_desktop "$@" ;;
  verify-desktop) shift; verify_desktop "$@" ;;
  build-official-baseline) build_official_baseline ;;
  update-official-baseline) shift; update_official_baseline "$@" ;;
  verify-official-baseline) verify_official_baseline ;;
  refresh-official-baseline) shift; refresh_official_baseline "$@" ;;
  rollback-official-baseline) shift; rollback_official_baseline "${1:-}" ;;
  update-all) update_all ;;
  launch-desktop) launch_desktop ;;
  rollback-desktop) shift; rollback_desktop "${1:-}" ;;
  install-refresh-task) shift; install_refresh_task "${1:-}" ;;
  refresh-task-status) refresh_task_status ;;
  uninstall-refresh-task) uninstall_refresh_task ;;
  ios-doctor) ios_doctor ;;
  ios-build-internal) shift; ios_build_internal "${1:-}" ;;
  ios-build-testflight) shift; ios_build_testflight "${1:-}" ;;
  ios-submit-testflight) shift; ios_submit_testflight "$@" ;;
  ios-publish-update) shift; ios_publish_update "$@" ;;
  ios-release-status) ios_release_status ;;
  ""|-h|--help|help) usage ;;
  *)
    usage
    exit 1
    ;;
esac
