    echo "Happy repo not found: $HAPPY_REPO" >&2
    exit 1
  fi
}

current_happy_commit() {
  git -C "$HAPPY_REPO" rev-parse --short HEAD
}

ensure_clean_repo() {
  local dirty
  dirty="$(git -C "$HAPPY_REPO" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    echo "Happy repo has local changes. Refusing to update:" >&2
    printf '%s\n' "$dirty" >&2
