}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing command: $1" >&2
    exit 1
  fi
}

check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'ok   %-14s %s\n' "$1" "$(command -v "$1")"
  else
    printf 'miss %-14s %s\n' "$1" "not found"
    return 1
  fi
}

check_pkg_config() {
  local pkg="$1"
  if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists "$pkg"; then
    printf 'ok   %-30s %s\n' "$pkg" "$(pkg-config --modversion "$pkg")"
  else
    printf 'miss %-30s %s\n' "$pkg" "pkg-config package not found"
    return 1
  fi
}

run_pnpm() {
  log "+ $HAPPY_PNPM_CMD $*"
  # shellcheck disable=SC2086
  $HAPPY_PNPM_CMD "$@"
}

ios_require_macos() {
  if [[ "$OS_NAME" != "Darwin" ]]; then
    echo "Happy iOS release commands require macOS with Xcode." >&2
    return 1
  fi
}

ios_eas_display_command() {
  printf 'cd %q && APP_ENV=%q NODE_ENV=production EXPO_NO_METRO_WORKSPACE_ROOT=1' "$HAPPY_IOS_APP_DIR" "$HAPPY_IOS_APP_ENV"
  if [[ -n "${EXPO_OWNER:-}" ]]; then
    printf ' EXPO_OWNER=<configured>'
  else
    printf ' EXPO_OWNER=<missing>'
  fi
  if [[ -n "${EXPO_PUBLIC_EAS_PROJECT_ID:-}" ]]; then
    printf ' EXPO_PUBLIC_EAS_PROJECT_ID=<configured>'
  else
    printf ' EXPO_PUBLIC_EAS_PROJECT_ID=<missing>'
  fi
  printf ' %q dlx %q' "$HAPPY_PNPM_CMD" "eas-cli@$HAPPY_IOS_EAS_CLI_VERSION"
  printf ' %q' "$@"
  printf '\n'
}

ios_run_eas() {
  log "+ $(ios_eas_display_command "$@")"
  (
    cd "$HAPPY_IOS_APP_DIR"
    APP_ENV="$HAPPY_IOS_APP_ENV" \
      NODE_ENV=production \
      EXPO_NO_METRO_WORKSPACE_ROOT=1 \
      EXPO_OWNER="${EXPO_OWNER:-}" \
      EXPO_PUBLIC_EAS_PROJECT_ID="${EXPO_PUBLIC_EAS_PROJECT_ID:-}" \
      APP_STORE_CONNECT_API_KEY_PATH="${APP_STORE_CONNECT_API_KEY_PATH:-}" \
      APP_STORE_CONNECT_API_KEY_ID="${APP_STORE_CONNECT_API_KEY_ID:-}" \
      APP_STORE_CONNECT_API_ISSUER_ID="${APP_STORE_CONNECT_API_ISSUER_ID:-}" \
      APP_STORE_CONNECT_APP_ID="${APP_STORE_CONNECT_APP_ID:-}" \
      APPLE_DEVELOPMENT_TEAM="${APPLE_DEVELOPMENT_TEAM:-}" \
      $HAPPY_PNPM_CMD dlx "eas-cli@$HAPPY_IOS_EAS_CLI_VERSION" "$@"
  )
}

ios_validate_eas_profiles() {
  node - "$HAPPY_IOS_APP_DIR/eas.json" "$HAPPY_IOS_INTERNAL_PROFILE" "$HAPPY_IOS_STORE_PROFILE" "$HAPPY_IOS_CHANNEL" <<'NODE'
const fs = require('node:fs');
const [path, internalName, storeName, channel] = process.argv.slice(2);
const value = JSON.parse(fs.readFileSync(path, 'utf8'));
const internal = value.build?.[internalName];
const store = value.build?.[storeName];
const submit = value.submit?.[storeName];
const failures = [];
if (!internal || internal.distribution !== 'internal' || internal.channel !== channel || internal.env?.APP_ENV !== 'personal') failures.push(`build.${internalName}`);
if (!store || store.distribution !== 'store' || store.channel !== channel || store.env?.APP_ENV !== 'personal') failures.push(`build.${storeName}`);
const expectedSubmit = {
  ascApiKeyPath: '$APP_STORE_CONNECT_API_KEY_PATH',
  ascApiKeyId: '$APP_STORE_CONNECT_API_KEY_ID',
  ascApiKeyIssuerId: '$APP_STORE_CONNECT_API_ISSUER_ID',
  ascAppId: '6806555472',
  appleTeamId: 'MJS6V7A44A',
};
if (!submit || !submit.ios) failures.push(`submit.${storeName}`);
for (const [key, expected] of Object.entries(expectedSubmit)) {
  if (submit?.ios?.[key] !== expected) failures.push(`submit.${storeName}.ios.${key} must use ${expected}`);
}
if (failures.length) {
  console.error(`Invalid personal EAS profiles: ${failures.join(', ')}`);
  process.exit(1);
}
NODE
}

ios_validate_expo_identity() {
  local owner project_id config_json
  owner="${EXPO_OWNER:-validation-owner}"
  project_id="${EXPO_PUBLIC_EAS_PROJECT_ID:-00000000-0000-4000-8000-000000000000}"
  config_json="$(
    APP_ENV="$HAPPY_IOS_APP_ENV" \
      NODE_ENV=production \
      EXPO_NO_METRO_WORKSPACE_ROOT=1 \
      EXPO_OWNER="$owner" \
      EXPO_PUBLIC_EAS_PROJECT_ID="$project_id" \
      $HAPPY_PNPM_CMD -C "$HAPPY_IOS_APP_DIR" exec expo config --type public --json
  )"
  PERSONAL_CONFIG_JSON="$config_json" node - "$project_id" <<'NODE'
const expectedProjectId = process.argv[2];
const config = JSON.parse(process.env.PERSONAL_CONFIG_JSON);
const ats = config.ios?.infoPlist?.NSAppTransportSecurity;
const checks = [
  ['name', config.name, 'Happy Personal'],
  ['slug', config.slug, 'happy-personal'],
  ['scheme', config.scheme, 'happy-personal'],
  ['ios.bundleIdentifier', config.ios?.bundleIdentifier, 'com.myartings.happy'],
  ['runtimeVersion.policy', config.runtimeVersion?.policy, 'appVersion'],
  ['extra.eas.projectId', config.extra?.eas?.projectId, expectedProjectId],
  ['ATS.NSAllowsLocalNetworking', ats?.NSAllowsLocalNetworking, true],
  ['ATS.NSAllowsArbitraryLoads', ats?.NSAllowsArbitraryLoads, undefined],
];
const failures = checks.filter(([, actual, expected]) => actual !== expected);
if (failures.length) {
  for (const [name, actual, expected] of failures) console.error(`${name}: expected ${String(expected)}, got ${String(actual)}`);
  process.exit(1);
}
NODE
}

ios_validate_local_configuration() {
  local failed=0
  ios_require_macos || failed=1
  ensure_repo
  if [[ -d "$HAPPY_IOS_APP_DIR" ]]; then
    printf 'ok   %-24s %s\n' "Happy iOS app" "$HAPPY_IOS_APP_DIR"
  else
    printf 'miss %-24s %s\n' "Happy iOS app" "$HAPPY_IOS_APP_DIR"
    failed=1
  fi
  check_cmd node || failed=1
  if ! $HAPPY_PNPM_CMD --version >/dev/null 2>&1; then
    printf 'miss %-24s %s\n' "pnpm" "$HAPPY_PNPM_CMD failed"
    failed=1
  else
    printf 'ok   %-24s %s\n' "pnpm" "$($HAPPY_PNPM_CMD --version 2>/dev/null | head -n 1)"
  fi
  check_cmd xcodebuild || failed=1
  if ios_validate_eas_profiles; then
    printf 'ok   %-24s %s\n' "EAS profiles" "$HAPPY_IOS_INTERNAL_PROFILE / $HAPPY_IOS_STORE_PROFILE"
  else
    failed=1
  fi
  if ios_validate_expo_identity; then
    printf 'ok   %-24s %s\n' "Personal identity" "Happy Personal / com.myartings.happy"
  else
    failed=1
  fi
  if [[ -n "${EXPO_OWNER:-}" ]]; then
    printf 'ok   %-24s %s\n' "EXPO_OWNER" "configured"
  else
    printf 'miss %-24s %s\n' "EXPO_OWNER" "set it in config.env"
    failed=1
  fi
  if [[ -n "${EXPO_PUBLIC_EAS_PROJECT_ID:-}" ]]; then
    printf 'ok   %-24s %s\n' "EAS project ID" "configured"
  else
    printf 'miss %-24s %s\n' "EAS project ID" "set EXPO_PUBLIC_EAS_PROJECT_ID in config.env"
    failed=1
  fi
  if [[ -n "${APP_STORE_CONNECT_APP_ID:-}" && -n "${APPLE_DEVELOPMENT_TEAM:-}" && -f "${APP_STORE_CONNECT_API_KEY_PATH:-}" ]]; then
    printf 'ok   %-24s %s\n' "TestFlight config" "configured"
  else
    printf 'info %-24s %s\n' "TestFlight config" "optional until first TestFlight submission"
  fi
  return "$failed"
}

ios_require_release_ready() {
  ios_validate_local_configuration
  ensure_clean_repo
  local branch
  branch="$(git -C "$HAPPY_REPO" branch --show-current)"
  if [[ "$branch" != "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    echo "Happy iOS releases must run from $HAPPY_DEVTOOLS_FINAL_BRANCH; current branch is $branch." >&2
    return 1
  fi
  ios_run_eas whoami >/dev/null
}

ios_require_submit_configuration() {
  local name
  for name in APP_STORE_CONNECT_API_KEY_PATH APP_STORE_CONNECT_API_KEY_ID \
    APP_STORE_CONNECT_API_ISSUER_ID APP_STORE_CONNECT_APP_ID APPLE_DEVELOPMENT_TEAM; do
    if [[ -z "${!name:-}" ]]; then
      echo "Missing $name in untracked config.env or the environment." >&2
      return 1
    fi
  done
  if [[ ! -f "$APP_STORE_CONNECT_API_KEY_PATH" ]]; then
    echo "App Store Connect API key file not found at the configured path." >&2
    return 1
  fi
}

ios_doctor() {
  local failed=0 branch dirty
  echo "Checking Happy Personal iOS release prerequisites..."
  ios_validate_local_configuration || failed=1
  branch="$(git -C "$HAPPY_REPO" branch --show-current 2>/dev/null || true)"
  dirty="$(git -C "$HAPPY_REPO" status --porcelain 2>/dev/null || true)"
  if [[ "$branch" == "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    printf 'ok   %-24s %s\n' "Release branch" "$branch"
  else
    printf 'warn %-24s %s\n' "Release branch" "current=$branch; release requires $HAPPY_DEVTOOLS_FINAL_BRANCH"
  fi
  if [[ -z "$dirty" ]]; then
    printf 'ok   %-24s %s\n' "Happy worktree" "clean"
  else
    printf 'warn %-24s %s\n' "Happy worktree" "dirty; release will refuse"
  fi
  if ios_run_eas whoami >/dev/null 2>&1; then
    printf 'ok   %-24s %s\n' "EAS login" "authenticated"
  else
    printf 'miss %-24s %s\n' "EAS login" "run eas login for the personal Expo account"
    failed=1
  fi
  return "$failed"
}

ios_parse_dry_run() {
  case "${1:-}" in
    "") echo 0 ;;
    --dry-run|-n) echo 1 ;;
    *) echo "Unknown option: $1" >&2; return 1 ;;
  esac
}

ios_release_action() {
  local kind="$1" profile="$2" dry_run="$3"
  shift 3
  if [[ "$dry_run" -eq 1 ]]; then
    echo "Happy Personal iOS $kind dry run"
    echo "Happy repo: $HAPPY_REPO"
    echo "Current branch: $(git -C "$HAPPY_REPO" branch --show-current 2>/dev/null || echo unknown)"
    echo "Required release branch: $HAPPY_DEVTOOLS_FINAL_BRANCH"
    echo "Profile: $profile"
    ios_validate_eas_profiles
    ios_validate_expo_identity
    ios_eas_display_command "$@"
    echo "No cloud build, submission, update, or report was created."
    return
  fi
  ios_require_release_ready
  ios_run_eas "$@"
  write_update_report "ios-$kind" \
    "Happy commit" "$(git -C "$HAPPY_REPO" rev-parse HEAD)" \
    "EAS profile" "$profile" \
    "iOS channel" "$HAPPY_IOS_CHANNEL" \
    "Status" "command completed"
}

ios_build_internal() {
  local dry_run
  dry_run="$(ios_parse_dry_run "${1:-}")"
  ios_release_action "build-internal" "$HAPPY_IOS_INTERNAL_PROFILE" "$dry_run" \
    build --profile "$HAPPY_IOS_INTERNAL_PROFILE" --platform ios
}

ios_build_testflight() {
  local dry_run
  dry_run="$(ios_parse_dry_run "${1:-}")"
  ios_release_action "build-testflight" "$HAPPY_IOS_STORE_PROFILE" "$dry_run" \
    build --profile "$HAPPY_IOS_STORE_PROFILE" --platform ios
}

ios_submit_testflight() {
  local dry_run=0 build_id=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --build-id)
        shift
        build_id="${1:-}"
        ;;
      *) echo "Unknown ios-submit-testflight option: $1" >&2; return 1 ;;
    esac
    shift
  done
  if [[ -z "$build_id" ]]; then
    echo "ios-submit-testflight requires --build-id ID from ios-release-status." >&2
    return 1
  fi
  if [[ ! "$build_id" =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "Invalid EAS build ID." >&2
    return 1
  fi
  if [[ "$dry_run" -eq 0 ]]; then
    ios_require_submit_configuration
  fi
  ios_release_action "submit-testflight" "$HAPPY_IOS_STORE_PROFILE" "$dry_run" \
    submit --profile "$HAPPY_IOS_STORE_PROFILE" --platform ios --id "$build_id"
}

ios_publish_update() {
  local dry_run=0 message=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --dry-run|-n) dry_run=1 ;;
      --message|-m)
        shift
        message="${1:-}"
        ;;
      *) echo "Unknown ios-publish-update option: $1" >&2; return 1 ;;
    esac
    shift
  done
  if [[ -z "$message" ]]; then
    echo "ios-publish-update requires --message TEXT." >&2
    return 1
  fi
  ios_release_action "publish-update" "$HAPPY_IOS_CHANNEL" "$dry_run" \
    update --channel "$HAPPY_IOS_CHANNEL" --environment "$HAPPY_IOS_EAS_ENVIRONMENT" \
    --platform ios --message "$message"
}

ios_release_status() {
  ios_require_macos
  ios_validate_local_configuration
  ios_run_eas whoami >/dev/null
  echo "Recent Happy Personal iOS builds"
  ios_run_eas build:list --platform ios --channel "$HAPPY_IOS_CHANNEL" --limit 10
  echo
  echo "Recent Happy Personal iOS submissions"
  ios_run_eas submit:list --platform ios --limit 10
}

happy_cli_path() {
  command -v happy 2>/dev/null || true
}

happy_cli_version_without_exec() {
  local happy_path npm_root package_json version
  happy_path="$(happy_cli_path)"
  if [[ -z "$happy_path" ]]; then
    echo "happy not found"
    return
  fi

  if command -v npm >/dev/null 2>&1; then
    npm_root="$(npm root -g 2>/dev/null || true)"
    package_json="$npm_root/happy/package.json"
    if [[ -f "$package_json" ]] && command -v node >/dev/null 2>&1; then
      version="$(node -e 'const fs=require("fs"); const p=process.argv[1]; console.log(JSON.parse(fs.readFileSync(p,"utf8")).version || "unknown")' "$package_json" 2>/dev/null || true)"
      if [[ -n "$version" ]]; then
        echo "happy@$version"
        return
      fi
    fi

    version="$(npm list -g --depth=0 happy 2>/dev/null | sed -n 's/.*happy@\\([^[:space:]]*\\).*/happy@\\1/p' | head -n 1)"
    if [[ -n "$version" ]]; then
      echo "$version"
      return
    fi
  fi

  echo "happy installed at $happy_path; version unknown without executing CLI"
}

