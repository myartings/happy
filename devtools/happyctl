mobile_sha256_stdin() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then
    sha256sum | awk '{print $1}'
  else
    echo "Missing SHA-256 tool: install shasum or sha256sum." >&2
    return 1
  fi
}

mobile_dirty_source_digest() {
  if [[ -z "$(git -C "$HAPPY_REPO" status --porcelain --untracked-files=all)" ]]; then
    printf 'clean\n'
    return
  fi
  {
    git -C "$HAPPY_REPO" status --porcelain=v1 -z --untracked-files=all
    git -C "$HAPPY_REPO" diff --cached --binary HEAD --
    git -C "$HAPPY_REPO" diff --binary --
    while IFS= read -r -d '' path; do
      printf '\0%s\0' "$path"
      git -C "$HAPPY_REPO" hash-object --no-filters -- "$path"
    done < <(git -C "$HAPPY_REPO" ls-files --others --exclude-standard -z)
  } | mobile_sha256_stdin | sed 's/^/sha256:/'
}

mobile_build_metadata_line() {
  local json_path="$1" mode="${2:-}"
  node - "$json_path" "$mode" <<'NODE'
const fs = require('node:fs');
const allowMissing = process.argv[3] === '--allow-missing';
let build = null;
let parseError = null;
try {
  const value = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
  build = Array.isArray(value) ? value[0] : (Array.isArray(value?.builds) ? value.builds[0] : value);
} catch (error) {
  parseError = error;
}
const invalidShape = (
  !build
  || typeof build !== 'object'
  || Array.isArray(build)
);
if (parseError || invalidShape) {
  if (!allowMissing) {
    const detail = parseError ? 'malformed JSON' : 'unrecognized build shape';
    console.error(`Invalid EAS build JSON: ${detail}.`);
    process.exit(1);
  }
  build = null;
}
const stringField = (value) => (
  typeof value === 'string' && value.trim() !== '' ? value.trim() : 'n/a'
);
const created = stringField(build?.createdAt);
const completed = stringField(build?.completedAt);
const startMs = Date.parse(created);
const endMs = Date.parse(completed);
const duration = Number.isFinite(startMs) && Number.isFinite(endMs)
  ? String(Math.max(0, Math.round((endMs - startMs) / 1000)))
  : 'n/a';
const values = [
  stringField(build?.status),
  stringField(build?.id),
  stringField(build?.platform),
  stringField(build?.buildProfile),
  stringField(build?.channel),
  stringField(typeof build?.fingerprint === 'string' ? build.fingerprint : build?.fingerprint?.hash),
  created,
  completed,
  duration,
  stringField(build?.artifacts?.buildUrl ?? build?.artifacts?.applicationArchiveUrl),
];
console.log(values.map((value) => String(value).replace(/[\t\r\n]+/g, ' ')).join('\t'));
NODE
}

mobile_build_artifact_url_from_json() {
  local metadata status build_id build_platform build_profile build_channel
  local fingerprint created completed eas_duration artifact_url
  metadata="$(mobile_build_metadata_line "$1" "${2:-}")"
  IFS=$'\t' read -r status build_id build_platform build_profile build_channel \
    fingerprint created completed eas_duration artifact_url <<<"$metadata"
  printf '%s\n' "$artifact_url"
}

mobile_write_build_report_from_json() {
  local platform="$1" kind="$2" profile="$3" source_commit="$4" dirty_digest="$5"
  local started_epoch="$6" ended_epoch="$7" process_exit="$8" effective_status="$9"
  local json_path="${10}" artifact_sha256="${11}"
  local metadata status build_id build_platform build_profile build_channel fingerprint
  local created completed eas_duration artifact_url duration process_outcome response_bytes response_sha256
  metadata="$(mobile_build_metadata_line "$json_path" --allow-missing)" || return
  IFS=$'\t' read -r status build_id build_platform build_profile build_channel \
    fingerprint created completed eas_duration artifact_url <<<"$metadata"
  response_bytes="$(wc -c <"$json_path" | tr -d '[:space:]')" || return
  response_sha256="$(mobile_sha256_stdin <"$json_path")" || return
  duration=$((ended_epoch - started_epoch))
  if [[ "$duration" -lt 0 ]]; then
    duration=0
  fi
  if [[ "$process_exit" -eq 0 ]]; then
    process_outcome="exited 0"
  else
    process_outcome="command failed (exit $process_exit)"
  fi
  write_update_report "$platform-$kind" \
    "Platform" "$platform" \
    "EAS profile" "$profile" \
    "EAS channel" "$HAPPY_MOBILE_CHANNEL" \
    "Returned EAS platform" "$build_platform" \
    "Returned EAS profile" "$build_profile" \
    "Returned EAS channel" "$build_channel" \
    "Source commit" "$source_commit" \
    "Dirty source digest" "$dirty_digest" \
    "Native fingerprint" "$fingerprint" \
    "EAS build ID" "$build_id" \
    "Duration seconds" "$duration" \
    "EAS created" "$created" \
    "EAS completed" "$completed" \
    "EAS duration seconds" "$eas_duration" \
    "Artifact URL" "$artifact_url" \
    "Artifact SHA-256" "$artifact_sha256" \
    "EAS response bytes" "$response_bytes" \
    "EAS response SHA-256" "$response_sha256" \
    "EAS process exit" "$process_exit" \
    "Command outcome" "$process_outcome" \
    "EAS status" "$status" \
    "Status" "$effective_status"
}

mobile_require_https_url() {
  node - "$1" <<'NODE'
try {
  const url = new URL(process.argv[2]);
  if (url.protocol !== 'https:' || !url.hostname || url.username || url.password) {
    throw new Error('unsupported URL');
  }
} catch {
  console.error('Artifact URL must be an HTTPS URL without embedded credentials.');
  process.exit(1);
}
NODE
}

mobile_stream_artifact_sha256() {
  mobile_require_https_url "$1" || return
  require_cmd curl || return
  curl --fail --location --silent --show-error \
    --proto '=https' --proto-redir '=https' -- "$1" | mobile_sha256_stdin
}

mobile_build_action() {
  local platform="$1" kind="$2" profile="$3" dry_run="$4" hash_artifact="$5"
  shift 5
  if [[ "$dry_run" -eq 1 ]]; then
    mobile_release_action "$platform" "$kind" "$profile" 1 "$@" --wait --json || return
    if [[ "$hash_artifact" -eq 1 ]]; then
      echo "Artifact SHA-256: requested only after a future successful build; no artifact was downloaded."
    else
      echo "Artifact SHA-256: not requested."
    fi
    return
  fi

  (
    mobile_require_release_ready "$platform" || exit
    local source_commit dirty_digest started_epoch ended_epoch json_path process_exit
    local effective_exit effective_status report_exit
    local metadata build_status build_id build_platform build_profile build_channel fingerprint
    local created completed eas_duration artifact_url artifact_sha256 hash_exit report_output
    local expected_eas_platform
    source_commit="$(git -C "$HAPPY_REPO" rev-parse HEAD)" || exit
    dirty_digest="$(mobile_dirty_source_digest)" || exit
    started_epoch="$(date '+%s')" || exit
    json_path="$(mktemp -t happy-mobile-build-XXXXXX.json)" || exit
    trap "rm -f -- $(printf '%q' "$json_path")" EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    process_exit=0
    if mobile_run_eas "$platform" "$@" --wait --json >"$json_path"; then
      :
    else
      process_exit=$?
    fi
    effective_exit="$process_exit"
    ended_epoch="$(date '+%s')" || exit

    case "$platform" in
      ios) expected_eas_platform="IOS" ;;
      android) expected_eas_platform="ANDROID" ;;
    esac
    if [[ "$process_exit" -ne 0 ]]; then
      effective_status="command failed (exit $process_exit)"
    elif metadata="$(mobile_build_metadata_line "$json_path")"; then
      IFS=$'\t' read -r build_status build_id build_platform build_profile build_channel \
        fingerprint created completed eas_duration artifact_url <<<"$metadata"
      if [[ "$build_status" == "n/a" ]]; then
        effective_status="command failed (invalid EAS build JSON)"
        effective_exit=1
      elif [[ "$build_status" != "FINISHED" ]]; then
        effective_status="build failed (EAS status: $build_status)"
        effective_exit=1
      elif [[ "$build_id" == "n/a" || "$build_platform" == "n/a" \
        || "$build_profile" == "n/a" || "$build_channel" == "n/a" ]]; then
        effective_status="command failed (invalid EAS build JSON)"
        effective_exit=1
      elif [[ "$build_platform" != "$expected_eas_platform" \
        || "$build_profile" != "$profile" \
        || "$build_channel" != "$HAPPY_MOBILE_CHANNEL" ]]; then
        effective_status="build failed (EAS build dimensions do not match request)"
        effective_exit=1
      else
        effective_status="FINISHED"
      fi
    else
      effective_status="command failed (invalid EAS build JSON)"
      effective_exit=1
    fi

    artifact_url="$(mobile_build_artifact_url_from_json "$json_path" --allow-missing)" || exit
    artifact_sha256="not computed (use --hash-artifact to stream the remote artifact)"
    hash_exit=0
    if [[ "$hash_artifact" -eq 1 ]]; then
      if [[ "$effective_exit" -ne 0 || "$artifact_url" == "n/a" ]]; then
        artifact_sha256="unavailable (the build did not return an artifact URL)"
        hash_exit=1
      elif artifact_sha256="$(mobile_stream_artifact_sha256 "$artifact_url")"; then
        :
      else
        artifact_sha256="failed to compute"
        hash_exit=1
      fi
    fi

    if report_output="$(mobile_write_build_report_from_json \
      "$platform" "$kind" "$profile" "$source_commit" "$dirty_digest" \
      "$started_epoch" "$ended_epoch" "$process_exit" "$effective_status" \
      "$json_path" "$artifact_sha256")"; then
      echo "$report_output"
    else
      report_exit=$?
      exit "$report_exit"
    fi
    if [[ "$effective_exit" -ne 0 ]]; then
      exit "$effective_exit"
    fi
    if [[ "$hash_exit" -ne 0 ]]; then
      exit "$hash_exit"
    fi
    exit 0
  )
}

