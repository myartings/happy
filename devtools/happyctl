    exit 1
  fi
}

git_ref_exists() {
  git -C "$HAPPY_REPO" rev-parse --verify --quiet "$1^{commit}" >/dev/null
}

is_devtools_path() {
  case "$1" in
    devtools/*|.agents/skills/happy-desktop-update/*|.agents/skills/happy-desktop-official-release/*|.agents/skills/happy-ios-release/*|AGENTS.md|.gitignore)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

assert_official_product_equivalence() {
  local upstream_ref="${1:-$HAPPY_DEVTOOLS_BASE_UPSTREAM}"
  local candidate_ref="${2:-HEAD}" path invalid=()
  if ! git_ref_exists "$upstream_ref"; then
    echo "Happy official upstream ref not found: $upstream_ref" >&2
    return 1
  fi
  if ! git_ref_exists "$candidate_ref"; then
    echo "Happy candidate ref not found: $candidate_ref" >&2
    return 1
  fi
  if ! git -C "$HAPPY_REPO" merge-base --is-ancestor "$upstream_ref" "$candidate_ref"; then
    echo "$candidate_ref does not contain the current official commit: $upstream_ref" >&2
    return 1
  fi
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    is_devtools_path "$path" || invalid+=("$path")
  done < <(git -C "$HAPPY_REPO" diff --name-only "$upstream_ref".."$candidate_ref")
  if [[ "${#invalid[@]}" -gt 0 ]]; then
    echo "Personal main changes product/build inputs outside the devtools allowlist:" >&2
    printf '  %s\n' "${invalid[@]}" >&2
    return 1
  fi
}

validate_base_branch_for_refresh() {
  assert_official_product_equivalence \
    "$HAPPY_DEVTOOLS_BASE_UPSTREAM" "$HAPPY_DEVTOOLS_BASE_BRANCH"
}

check_git_push_guard() {
  local configured hooks_path source_hook expected_hook
  configured="$(git -C "$HAPPY_REPO" config --local --get core.hooksPath || true)"
  hooks_path="$(git_push_guard_install_dir)"
  source_hook="$HAPPY_REPO/$HAPPY_GIT_HOOKS_SOURCE/pre-push"
  expected_hook="$hooks_path/pre-push"
  if [[ "$configured" != "$hooks_path" || ! -x "$source_hook" || ! -x "$expected_hook" || ! -s "$expected_hook" ]] || ! cmp -s "$source_hook" "$expected_hook"; then
    echo "Happy Git push guard is not active; run: devtools/happyctl install-git-guards" >&2
    echo "Expected core.hooksPath=$hooks_path and an up-to-date executable $expected_hook" >&2
    return 1
  fi
  printf 'ok   %-14s %s\n' "Git push guard" "$expected_hook"
}

git_push_guard_install_dir() {
  local git_common_dir
  git_common_dir="$(git -C "$HAPPY_REPO" rev-parse --path-format=absolute --git-common-dir)"
  printf '%s/happy-hooks\n' "$git_common_dir"
}

install_git_push_guard() {
  ensure_repo
  local configured hooks_path source_hook installed_hook
  configured="$(git -C "$HAPPY_REPO" config --local --get core.hooksPath || true)"
  hooks_path="$(git_push_guard_install_dir)"
  source_hook="$HAPPY_REPO/$HAPPY_GIT_HOOKS_SOURCE/pre-push"
  installed_hook="$hooks_path/pre-push"
  if [[ ! -x "$source_hook" ]]; then
    echo "Tracked Happy pre-push hook is missing or not executable: $source_hook" >&2
    return 1
  fi
  if [[ -n "$configured" && "$configured" != "$hooks_path" && "$configured" != "$HAPPY_GIT_HOOKS_SOURCE" ]]; then
    echo "Refusing to replace existing core.hooksPath=$configured" >&2
    echo "Review the existing hooks before installing the Happy guard." >&2
    return 1
  fi
  mkdir -p "$hooks_path"
  cp "$source_hook" "$installed_hook"
  chmod +x "$installed_hook"
  git -C "$HAPPY_REPO" config --local core.hooksPath "$hooks_path"
  check_git_push_guard >/dev/null
  echo "Installed Happy Git push guard: $installed_hook"
}

validate_main_push_candidate() {
  local local_ref="${1:-}" candidate_ref="${2:-}"
  local expected_local_ref="refs/heads/$HAPPY_DEVTOOLS_BASE_BRANCH"
  if [[ "$local_ref" != "$expected_local_ref" ]]; then
    echo "Pushes to origin/main must originate from local $HAPPY_DEVTOOLS_BASE_BRANCH; got $local_ref." >&2
    return 1
  fi
  if [[ "${HAPPY_MAIN_PUSH_GUARD:-}" != "happyctl-sync" ]]; then
    echo "Pushes to origin/main must run through devtools/happyctl sync-dev." >&2
    return 1
  fi
  assert_official_product_equivalence "$HAPPY_DEVTOOLS_BASE_UPSTREAM" "$candidate_ref"
}

validate_patch_stack() {
  local branches=()
  # shellcheck disable=SC2206
  branches=($HAPPY_DEVTOOLS_PATCH_BRANCHES)

  if [[ "${#branches[@]}" -eq 0 ]]; then
    echo "HAPPY_DEVTOOLS_PATCH_BRANCHES must contain at least one branch." >&2
    return 1
  fi
  if [[ "${branches[${#branches[@]}-1]}" != "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    echo "Final integration branch must be the last branch in HAPPY_DEVTOOLS_PATCH_BRANCHES." >&2
    echo "Expected last branch: $HAPPY_DEVTOOLS_FINAL_BRANCH" >&2
    return 1
  fi
  if ! git_ref_exists "$HAPPY_DEVTOOLS_BASE_BRANCH"; then
    echo "Happy base branch not found: $HAPPY_DEVTOOLS_BASE_BRANCH" >&2
    return 1
  fi
  if ! git_ref_exists "$HAPPY_DEVTOOLS_BASE_UPSTREAM"; then
    echo "Happy official upstream ref not found: $HAPPY_DEVTOOLS_BASE_UPSTREAM" >&2
    return 1
  fi

  local branch
  for branch in "${branches[@]}"; do
    if ! git_ref_exists "$branch"; then
      echo "Happy integration branch not found: $branch" >&2
      return 1
    fi
  done
}

fetch_patch_stack_remotes() {
  log "+ git -C $HAPPY_REPO fetch --prune --tags upstream" >/dev/null
  git -C "$HAPPY_REPO" fetch --prune --tags upstream >&2
  log "+ git -C $HAPPY_REPO fetch --prune --tags origin" >/dev/null
  git -C "$HAPPY_REPO" fetch --prune --tags origin >&2
}

happy_patch_stack_state() {
  local fetch="${1:-}"
  ensure_repo
  ensure_clean_repo

  if [[ "$fetch" == "fetch" ]]; then
    fetch_patch_stack_remotes
  fi
  validate_patch_stack

  local base_counts final_counts base_ahead base_behind final_ahead final_behind
  local branch_remote_delta=0 branches=() branch remote_ref branch_counts branch_ahead branch_behind
  base_counts="$(git -C "$HAPPY_REPO" rev-list --left-right --count "$HAPPY_DEVTOOLS_BASE_BRANCH...$HAPPY_DEVTOOLS_BASE_UPSTREAM")"
  base_ahead="${base_counts%%[[:space:]]*}"
  base_behind="${base_counts##*[[:space:]]}"
  final_counts="$(git -C "$HAPPY_REPO" rev-list --left-right --count "$HAPPY_DEVTOOLS_FINAL_BRANCH...$HAPPY_DEVTOOLS_BASE_UPSTREAM")"
  final_ahead="${final_counts%%[[:space:]]*}"
  final_behind="${final_counts##*[[:space:]]}"

  # shellcheck disable=SC2206
  branches=($HAPPY_DEVTOOLS_PATCH_BRANCHES)
  for branch in "${branches[@]}"; do
    remote_ref="origin/$branch"
    if git_ref_exists "$remote_ref"; then
      branch_counts="$(git -C "$HAPPY_REPO" rev-list --left-right --count "$branch...$remote_ref")"
      branch_ahead="${branch_counts%%[[:space:]]*}"
      branch_behind="${branch_counts##*[[:space:]]}"
    else
      branch_ahead=1
      branch_behind=0
    fi
    branch_remote_delta=$((branch_remote_delta + branch_ahead + branch_behind))
  done

  printf '%s|%s|%s|%s|%s\n' \
    "$base_ahead" "$base_behind" "$final_ahead" "$final_behind" "$branch_remote_delta"
}

show_patch_stack_state() {
  local state="$1"
  local base_ahead base_behind final_ahead final_behind branch_remote_delta
  IFS='|' read -r base_ahead base_behind final_ahead final_behind branch_remote_delta <<<"$state"

  echo "Happy personal integration branch"
  echo "Official:      $HAPPY_DEVTOOLS_BASE_UPSTREAM"
  echo "Base branch:   $HAPPY_DEVTOOLS_BASE_BRANCH"
  echo "Integration:   $HAPPY_DEVTOOLS_PATCH_BRANCHES"
  echo "Build branch:  $HAPPY_DEVTOOLS_FINAL_BRANCH"
  echo "Base ahead:    $base_ahead"
  echo "Base behind:   $base_behind"
  echo "Final ahead:   $final_ahead"
  echo "Final behind:  $final_behind"
  echo "Personal branch/remote commit delta: $branch_remote_delta"
}

abort_patch_stack_merge() {
  if git -C "$HAPPY_REPO" rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
    git -C "$HAPPY_REPO" merge --abort >/dev/null 2>&1 || true
  fi
}

validate_personal_feature_surface() {
  local personal_screen personal_route settings_view path setting_key settings_entry_line developer_boundary_line
  local required_paths=() protected_setting_keys=()

  personal_screen="packages/happy-app/sources/features/personal-settings/PersonalFeaturesSettingsScreen.tsx"
  personal_route="packages/happy-app/sources/app/(app)/settings/personal-features.tsx"
  settings_view="packages/happy-app/sources/components/SettingsView.tsx"
  required_paths=("$personal_screen" "$personal_route" "$settings_view")
  protected_setting_keys=(
    flatSessionList
    devSideChatQuickPanelEnabled
    devProjectTodosEnabled
    devGithubIssuesEnabled
    needsAttentionSessionsEnabled
    devPromptHistoryNavigatorEnabled
    devSessionEnvironmentLabelsEnabled
    devEnhancedStatusDotsEnabled
    sortActiveSessionsGlobally
    groupActiveSessionsByDate
    devShowActiveSessionRuntimeEnabled
    devShowSessionModelEnabled
    desktopSessionNotificationsEnabled
  )

  for path in "${required_paths[@]}"; do
    if [[ ! -f "$HAPPY_REPO/$path" ]]; then
      echo "Personal feature sync guard: missing $path" >&2
      return 1
    fi
  done

  if ! grep -Fq "@/features/personal-settings/PersonalFeaturesSettingsScreen" "$HAPPY_REPO/$personal_route"; then
    echo "Personal feature sync guard: route no longer delegates to the personal feature module" >&2
    return 1
  fi
  settings_entry_line="$(grep -nF "router.push('/settings/personal-features')" "$HAPPY_REPO/$settings_view" | head -n 1 | cut -d: -f1 || true)"
  developer_boundary_line="$(grep -nF '{/* Developer */}' "$HAPPY_REPO/$settings_view" | head -n 1 | cut -d: -f1 || true)"
  if [[ -z "$settings_entry_line" || -z "$developer_boundary_line" || "$settings_entry_line" -ge "$developer_boundary_line" ]]; then
    echo "Personal feature sync guard: always-visible Settings entry is missing" >&2
    return 1
  fi

  for setting_key in "${protected_setting_keys[@]}"; do
    if ! grep -Eq "use(Local)?SettingMutable\\('$setting_key'\\)" "$HAPPY_REPO/$personal_screen"; then
      echo "Personal feature sync guard: missing protected switch $setting_key" >&2
      return 1
    fi
  done

  echo "ok   personal features: protected surface verified"
}

sync_patch_stack_locally() {
  ensure_repo
  ensure_clean_repo
  validate_patch_stack

  local original_branch parent branch remote_ref branches=()
  original_branch="$(git -C "$HAPPY_REPO" branch --show-current)"
  if [[ -z "$original_branch" ]]; then
    echo "Happy repo is in detached HEAD state; refusing automatic dev integration sync." >&2
    return 1
  fi

  if ! run git -C "$HAPPY_REPO" switch "$HAPPY_DEVTOOLS_BASE_BRANCH"; then
    return 1
  fi
  if git_ref_exists "origin/$HAPPY_DEVTOOLS_BASE_BRANCH"; then
    if ! run git -C "$HAPPY_REPO" merge --ff-only "origin/$HAPPY_DEVTOOLS_BASE_BRANCH"; then
      run git -C "$HAPPY_REPO" switch "$original_branch" || true
      return 1
    fi
  fi
  if ! run git -C "$HAPPY_REPO" merge --no-edit "$HAPPY_DEVTOOLS_BASE_UPSTREAM"; then
    run git -C "$HAPPY_REPO" switch "$original_branch" || true
    return 1
  fi
  assert_official_product_equivalence || {
    run git -C "$HAPPY_REPO" switch "$original_branch" || true
    return 1
  }

  parent="$HAPPY_DEVTOOLS_BASE_BRANCH"
  # shellcheck disable=SC2206
  branches=($HAPPY_DEVTOOLS_PATCH_BRANCHES)
  for branch in "${branches[@]}"; do
    if ! run git -C "$HAPPY_REPO" switch "$branch"; then
      run git -C "$HAPPY_REPO" switch "$original_branch" || true
      return 1
    fi

    remote_ref="origin/$branch"
    if git_ref_exists "$remote_ref"; then
      if ! run git -C "$HAPPY_REPO" merge --ff-only "$remote_ref"; then
        echo "$branch has diverged from $remote_ref; refusing automatic reconciliation." >&2
        run git -C "$HAPPY_REPO" switch "$original_branch" || true
        return 1
      fi
    fi

    if ! run git -C "$HAPPY_REPO" merge --no-edit "$parent"; then
      echo "Patch-stack merge conflict while merging $parent into $branch." >&2
      abort_patch_stack_merge
      run git -C "$HAPPY_REPO" switch "$original_branch" || true
      return 1
    fi
    parent="$branch"
  done

  if [[ "$parent" != "$HAPPY_DEVTOOLS_FINAL_BRANCH" ]]; then
    echo "Patch-stack configuration did not finish on $HAPPY_DEVTOOLS_FINAL_BRANCH." >&2
    run git -C "$HAPPY_REPO" switch "$original_branch" || true
    return 1
  fi

  if ! validate_personal_feature_surface; then
    echo "Final personal branch lost its protected feature settings surface; refusing push, build, or install." >&2
    run git -C "$HAPPY_REPO" switch "$original_branch" || true
    return 1
  fi
}

push_patch_stack() {
  local branches=() branch
  if ! (
    export HAPPY_MAIN_PUSH_GUARD=happyctl-sync
    run git -C "$HAPPY_REPO" push origin "$HAPPY_DEVTOOLS_BASE_BRANCH:$HAPPY_DEVTOOLS_BASE_BRANCH"
  ); then
    return 1
  fi
  # shellcheck disable=SC2206
  branches=($HAPPY_DEVTOOLS_PATCH_BRANCHES)
  for branch in "${branches[@]}"; do
    if ! run git -C "$HAPPY_REPO" push --set-upstream origin "$branch:$branch"; then
      return 1
    fi
  done
}

sync_patch_stack_command() {
  local dry_run=0
  case "${1:-}" in
    "") ;;
    --dry-run|-n) dry_run=1 ;;
    *)
      echo "Unknown sync-patch-stack option: $1" >&2
      return 1
      ;;
  esac

  ensure_repo
  ensure_clean_repo
  validate_patch_stack
  if [[ "$dry_run" -eq 1 ]]; then
    echo "Happy dev integration sync dry run"
    echo "Would fetch upstream and origin, then update:"
    echo "  $HAPPY_DEVTOOLS_BASE_UPSTREAM -> $HAPPY_DEVTOOLS_BASE_BRANCH -> $HAPPY_DEVTOOLS_PATCH_BRANCHES"
    echo "Would push personal main and the personal dev branch to origin."
    echo "No changes made."
    return
  fi

  check_git_push_guard >/dev/null

  local state
  state="$(happy_patch_stack_state fetch)"
  show_patch_stack_state "$state"
  sync_patch_stack_locally
  push_patch_stack
  echo "Dev integration synchronized. Final build branch: $HAPPY_DEVTOOLS_FINAL_BRANCH"
}

happy_upstream_ref() {
  local upstream
  upstream="$(git -C "$HAPPY_REPO" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
  if [[ -n "$upstream" ]]; then
    printf '%s\n' "$upstream"
    return
  fi

  if git -C "$HAPPY_REPO" rev-parse --verify --quiet origin/main >/dev/null; then
    printf '%s\n' "origin/main"
    return
  fi
}

happy_upstream_state() {
  local fetch="${1:-}"
  ensure_repo
  ensure_clean_repo

  if [[ "$fetch" == "fetch" ]]; then
    log "+ git -C $HAPPY_REPO fetch --prune" >/dev/null
    git -C "$HAPPY_REPO" fetch --prune >&2
  fi

  local upstream local_commit remote_commit counts ahead behind
  upstream="$(happy_upstream_ref)"
  if [[ -z "$upstream" ]]; then
    echo "Could not determine Happy repo upstream. Configure branch upstream or origin/main." >&2
    exit 1
  fi

  local_commit="$(git -C "$HAPPY_REPO" rev-parse HEAD)"
  remote_commit="$(git -C "$HAPPY_REPO" rev-parse "$upstream")"
  counts="$(git -C "$HAPPY_REPO" rev-list --left-right --count "HEAD...$upstream")"
  ahead="${counts%%[[:space:]]*}"
  behind="${counts##*[[:space:]]}"

  printf '%s|%s|%s|%s|%s\n' "$upstream" "$local_commit" "$remote_commit" "$ahead" "$behind"
}

show_upstream_state() {
  local state="$1"
  local upstream local_commit remote_commit ahead behind
  IFS='|' read -r upstream local_commit remote_commit ahead behind <<<"$state"

  echo "Happy upstream"
  echo "Repo:      $HAPPY_REPO"
  echo "Upstream:  $upstream"
  echo "Local:     $local_commit"
  echo "Remote:    $remote_commit"
  echo "Ahead:     $ahead"
  echo "Behind:    $behind"
  if [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
    echo "Status:    diverged"
  elif [[ "$behind" -gt 0 ]]; then
    echo "Status:    update available"
  else
    echo "Status:    up to date"
  fi
}

check_upstream() {
  local state ahead behind
  state="$(happy_upstream_state fetch)"
  show_upstream_state "$state"
  IFS='|' read -r _ _ _ ahead behind <<<"$state"
  if [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
    exit 2
  fi
}

