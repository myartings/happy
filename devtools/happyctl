#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
HAPPY_REPO="${HAPPY_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

OS_NAME="$(uname -s)"
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.nvm/versions/node/v22.22.1/bin:$PATH"

case "$OS_NAME" in
  Darwin)
    HAPPY_DEVTOOLS_STATE_DIR="${HAPPY_DEVTOOLS_STATE_DIR:-$HOME/Library/Application Support/Happy Devtools}"
    HAPPY_APP_NAME="${HAPPY_APP_NAME:-Happy (dev).app}"
    HAPPY_APP_BUNDLE_ID="${HAPPY_APP_BUNDLE_ID:-com.slopus.happy.dev}"
    HAPPY_INSTALL_DIR="${HAPPY_INSTALL_DIR:-/Applications}"
    ;;
  Linux)
    HAPPY_DEVTOOLS_STATE_DIR="${HAPPY_DEVTOOLS_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/happy-devtools}"
    HAPPY_APP_NAME="${HAPPY_APP_NAME:-Happy (dev)}"
    HAPPY_APP_BUNDLE_ID="${HAPPY_APP_BUNDLE_ID:-com.slopus.happy.dev}"
    HAPPY_INSTALL_DIR="${HAPPY_INSTALL_DIR:-$HOME/.local/share/applications}"
    ;;
  *)
    HAPPY_DEVTOOLS_STATE_DIR="${HAPPY_DEVTOOLS_STATE_DIR:-$HOME/.local/state/happy-devtools}"
    HAPPY_APP_NAME="${HAPPY_APP_NAME:-Happy (dev).app}"
    HAPPY_APP_BUNDLE_ID="${HAPPY_APP_BUNDLE_ID:-com.slopus.happy.dev}"
    HAPPY_INSTALL_DIR="${HAPPY_INSTALL_DIR:-/Applications}"
    ;;
esac

HAPPY_TAURI_CONFIG="${HAPPY_TAURI_CONFIG:-src-tauri/tauri.dev.conf.json}"
if [[ "$OS_NAME" == "Linux" ]]; then
  HAPPY_PNPM_CMD="${HAPPY_PNPM_CMD:-corepack pnpm@10.11.0}"
  HAPPY_LINUX_BUNDLES="${HAPPY_LINUX_BUNDLES:-deb,rpm}"
else
  HAPPY_PNPM_CMD="${HAPPY_PNPM_CMD:-pnpm}"
fi
HAPPY_DEVTOOLS_REFRESH_LABEL="${HAPPY_DEVTOOLS_REFRESH_LABEL:-com.myartings.happyctl.refresh}"
HAPPY_DEVTOOLS_REFRESH_TIME="${HAPPY_DEVTOOLS_REFRESH_TIME:-09:00}"
HAPPY_DEVTOOLS_KEEP_BACKUPS="${HAPPY_DEVTOOLS_KEEP_BACKUPS:-3}"
HAPPY_DEVTOOLS_BASE_BRANCH="${HAPPY_DEVTOOLS_BASE_BRANCH:-main}"
HAPPY_DEVTOOLS_BASE_UPSTREAM="${HAPPY_DEVTOOLS_BASE_UPSTREAM:-upstream/main}"
HAPPY_DEVTOOLS_PATCH_BRANCHES="${HAPPY_DEVTOOLS_PATCH_BRANCHES:-dev}"
HAPPY_DEVTOOLS_FINAL_BRANCH="${HAPPY_DEVTOOLS_FINAL_BRANCH:-dev}"
HAPPY_GIT_HOOKS_SOURCE="${HAPPY_GIT_HOOKS_SOURCE:-devtools/git-hooks}"
HAPPY_PRIMARY_WORKTREE="$(git -C "$HAPPY_REPO" worktree list --porcelain 2>/dev/null | awk '/^worktree / && !found { sub(/^worktree /, ""); print; found=1 }')"
HAPPY_PRIMARY_WORKTREE="${HAPPY_PRIMARY_WORKTREE:-$HAPPY_REPO}"
HAPPY_OFFICIAL_BASELINE_WORKTREE="${HAPPY_OFFICIAL_BASELINE_WORKTREE:-$HAPPY_PRIMARY_WORKTREE/.baseline/worktree/official-main}"

HAPPY_DEVTOOLS_CONFIG="${HAPPY_DEVTOOLS_CONFIG:-$HAPPY_DEVTOOLS_STATE_DIR/config.env}"
if [[ ! -f "$HAPPY_DEVTOOLS_CONFIG" && -f "$SCRIPT_DIR/config.env" ]]; then
  HAPPY_DEVTOOLS_CONFIG="$SCRIPT_DIR/config.env"
fi
if [[ ! -f "$HAPPY_DEVTOOLS_CONFIG" ]]; then
  case "$OS_NAME" in
    Darwin) LEGACY_DEVTOOLS_CONFIG="/Users/myartings/workspace/happy-manager/config.env" ;;
    Linux) LEGACY_DEVTOOLS_CONFIG="/home/myartings/workspace/happy-manager/config.env" ;;
    *) LEGACY_DEVTOOLS_CONFIG="" ;;
  esac
  [[ -n "$LEGACY_DEVTOOLS_CONFIG" && -f "$LEGACY_DEVTOOLS_CONFIG" ]] && HAPPY_DEVTOOLS_CONFIG="$LEGACY_DEVTOOLS_CONFIG"
fi
if [[ -f "$HAPPY_DEVTOOLS_CONFIG" ]]; then
  # shellcheck disable=SC1091
  source "$HAPPY_DEVTOOLS_CONFIG"
fi
HAPPY_DEVTOOLS_BACKUP_DIR="${HAPPY_DEVTOOLS_BACKUP_DIR:-$HAPPY_DEVTOOLS_STATE_DIR/backups}"
HAPPY_DEVTOOLS_LOG_DIR="${HAPPY_DEVTOOLS_LOG_DIR:-$HAPPY_DEVTOOLS_STATE_DIR/logs}"
HAPPY_DEVTOOLS_REPORT_DIR="${HAPPY_DEVTOOLS_REPORT_DIR:-$HAPPY_DEVTOOLS_STATE_DIR/reports}"

HAPPY_IOS_APP_DIR="${HAPPY_IOS_APP_DIR:-$HAPPY_REPO/packages/happy-app}"
HAPPY_IOS_EAS_CLI_VERSION="${HAPPY_IOS_EAS_CLI_VERSION:-21.7.0}"
HAPPY_IOS_APP_ENV="${HAPPY_IOS_APP_ENV:-personal}"
HAPPY_IOS_INTERNAL_PROFILE="${HAPPY_IOS_INTERNAL_PROFILE:-personal}"
HAPPY_IOS_STORE_PROFILE="${HAPPY_IOS_STORE_PROFILE:-personal-store}"
HAPPY_IOS_CHANNEL="${HAPPY_IOS_CHANNEL:-personal}"
HAPPY_IOS_EAS_ENVIRONMENT="${HAPPY_IOS_EAS_ENVIRONMENT:-preview}"

HAPPY_DESKTOP_PROFILE="personal"

refresh_desktop_paths() {
  INSTALL_APP="$HAPPY_INSTALL_DIR/$HAPPY_APP_NAME"
  TAURI_TARGET_DIR="$HAPPY_REPO/packages/happy-app/src-tauri/target/release"
  BUILD_APP="$TAURI_TARGET_DIR/bundle/macos/$HAPPY_APP_NAME"
}

set_desktop_profile() {
  case "$1" in
    personal)
      HAPPY_DESKTOP_PROFILE="personal"
      HAPPY_APP_NAME="Happy (dev).app"
      HAPPY_APP_BUNDLE_ID="com.slopus.happy.dev"
      HAPPY_TAURI_CONFIG="src-tauri/tauri.dev.conf.json"
      ;;
    official-baseline)
      HAPPY_DESKTOP_PROFILE="official-baseline"
      HAPPY_APP_NAME="Happy (official baseline).app"
      HAPPY_APP_BUNDLE_ID="com.slopus.happy.official-baseline"
      HAPPY_TAURI_CONFIG="$HAPPY_REPO/devtools/config/tauri.official-baseline.conf.json"
      ;;
    *)
      echo "Unknown desktop profile: $1" >&2
      return 1
      ;;
  esac
  refresh_desktop_paths
}

refresh_desktop_paths
LINUX_EXECUTABLE="$TAURI_TARGET_DIR/app"
LINUX_INSTALLED_EXECUTABLE="${LINUX_INSTALLED_EXECUTABLE:-/usr/bin/app}"
LINUX_PACKAGE_NAME="${LINUX_PACKAGE_NAME:-happy-dev}"
HAPPY_LINUX_LAUNCH_TIMEOUT="${HAPPY_LINUX_LAUNCH_TIMEOUT:-20}"
LOG_FILE="$HAPPY_DEVTOOLS_LOG_DIR/happyctl.log"
LAUNCH_AGENT_PLIST="$HOME/Library/LaunchAgents/$HAPPY_DEVTOOLS_REFRESH_LABEL.plist"

log() {
  mkdir -p "$HAPPY_DEVTOOLS_LOG_DIR"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG_FILE"
}

run() {
  log "+ $*"
  "$@"
}

report_value() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    printf 'n/a'
  else
    printf '%s' "$value" | tr '\n' ' '
  fi
}

write_update_report() {
  local kind="$1"
  shift
  mkdir -p "$HAPPY_DEVTOOLS_REPORT_DIR"
  local stamp path
  stamp="$(date '+%Y%m%d-%H%M%S')"
  path="$HAPPY_DEVTOOLS_REPORT_DIR/$stamp-$kind.md"
  {
    echo "# Happy Devtools Update Report"
    echo
    echo "- Generated: $(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "- Kind: $kind"
    while [[ "$#" -gt 0 ]]; do
      local key="$1"
      local value="${2:-}"
      echo "- $key: $(report_value "$value")"
      shift 2
    done
  } >"$path"
  log "Update report: $path" >/dev/null
  echo "Update report: $path"
}

