  cat <<'EOF'
Usage:
  devtools/happyctl doctor
  devtools/happyctl status
  devtools/happyctl check-upstream
  devtools/happyctl install-git-guards
  devtools/happyctl sync-dev [--dry-run]
  devtools/happyctl sync-patch-stack [--dry-run]  # compatibility alias
  devtools/happyctl update-cli
  devtools/happyctl build-desktop
  devtools/happyctl artifacts
  devtools/happyctl update-desktop [--dry-run] [--launch-smoke]
  devtools/happyctl refresh-desktop [--dry-run] [--force] [--keep-backups N] [--launch-smoke]
  devtools/happyctl verify-desktop [--launch]
  devtools/happyctl build-official-baseline
  devtools/happyctl update-official-baseline [--keep-backups N]
  devtools/happyctl verify-official-baseline
  devtools/happyctl refresh-official-baseline [--dry-run] [--keep-backups N]
  devtools/happyctl rollback-official-baseline [backup.app]
  devtools/happyctl update-all
  devtools/happyctl launch-desktop
  devtools/happyctl rollback-desktop [backup.app]
  devtools/happyctl install-refresh-task [HH:MM]
  devtools/happyctl refresh-task-status
  devtools/happyctl uninstall-refresh-task
  devtools/happyctl ios-doctor
  devtools/happyctl ios-build-internal [--dry-run]
  devtools/happyctl ios-build-testflight [--dry-run]
  devtools/happyctl ios-submit-testflight --build-id ID [--dry-run]
