# Copy to config.env if you need local overrides.

HAPPY_REPO="/Users/myartings/workspace/happy"
HAPPY_APP_NAME="Happy (dev).app"
HAPPY_APP_BUNDLE_ID="com.slopus.happy.dev"
HAPPY_INSTALL_DIR="/Applications"
HAPPY_TAURI_CONFIG="src-tauri/tauri.dev.conf.json"
HAPPY_DEVTOOLS_STATE_DIR="$HOME/Library/Application Support/Happy Devtools"
HAPPY_DEVTOOLS_BACKUP_DIR="$HAPPY_DEVTOOLS_STATE_DIR/backups"
HAPPY_DEVTOOLS_LOG_DIR="$HAPPY_DEVTOOLS_STATE_DIR/logs"
HAPPY_DEVTOOLS_REPORT_DIR="$HAPPY_DEVTOOLS_STATE_DIR/reports"
HAPPY_DEVTOOLS_REFRESH_LABEL="com.myartings.happyctl.refresh"
HAPPY_DEVTOOLS_REFRESH_TIME="09:00"
HAPPY_DEVTOOLS_KEEP_BACKUPS="3"

# Optional macOS override. When unset, happyctl automatically prefers a valid
# Apple Development identity, then Developer ID Application. It refuses to
# install with an ad-hoc signature when neither is available.
# HAPPY_MACOS_SIGNING_IDENTITY="Apple Development: Your Name (TEAMID)"

# Personal integration flow. refresh-desktop merges official updates into the
# devtools-bearing personal main, validates product equivalence, then merges
# main into dev and always packages dev.
HAPPY_DEVTOOLS_BASE_BRANCH="main"
HAPPY_DEVTOOLS_BASE_UPSTREAM="upstream/main"
HAPPY_DEVTOOLS_PATCH_BRANCHES="dev"
HAPPY_DEVTOOLS_FINAL_BRANCH="dev"

# Public GitHub App identifiers required by personal Desktop builds. These are
# not secrets, but keep machine-specific values in untracked config.env.
EXPO_PUBLIC_HAPPY_GITHUB_ISSUES_CLIENT_ID="your-github-app-client-id"
EXPO_PUBLIC_HAPPY_GITHUB_ISSUES_APP_SLUG="your-github-app-slug"

# Happy Personal iOS release. Copy real values into untracked config.env.
HAPPY_IOS_EAS_CLI_VERSION="21.7.0"
HAPPY_IOS_APP_ENV="personal"
HAPPY_IOS_INTERNAL_PROFILE="personal"
HAPPY_IOS_STORE_PROFILE="personal-store"
HAPPY_IOS_CHANNEL="personal"
HAPPY_IOS_EAS_ENVIRONMENT="preview"
EXPO_OWNER="your-personal-expo-owner"
EXPO_PUBLIC_EAS_PROJECT_ID="your-personal-eas-project-id"

# Required only for non-interactive TestFlight submission. Keep real values in
# untracked config.env; never commit the .p8 key.
APP_STORE_CONNECT_API_KEY_PATH="/absolute/path/to/AuthKey_ID.p8"
APP_STORE_CONNECT_API_KEY_ID="your-key-id"
APP_STORE_CONNECT_API_ISSUER_ID="your-issuer-uuid"
APP_STORE_CONNECT_APP_ID="your-numeric-app-id"
APPLE_DEVELOPMENT_TEAM="your-team-id"
